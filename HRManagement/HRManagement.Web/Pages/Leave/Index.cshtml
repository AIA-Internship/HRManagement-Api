@page
@model HRManagement.Web.Pages.Leave.IndexModel
@{
    ViewData["Title"] = "Leave test page";
}
<>
    <h1>Leave test page</h1>
    @await Html.PartialAsync("LeaveManagement/_Calendar")
    <!--  include modal -->
    @await Html.PartialAsync("LeaveManagement/_PartialLeaveCalendarModal")
</>



@section Scripts {
    <script src='/assets/lib/fullcalendar/packages/core/main.js'></script>
    <script src='/assets/lib/fullcalendar/packages/interaction/main.js'></script>
    <script src='/assets/lib/fullcalendar/packages/daygrid/main.js'></script>
    <script src='/assets/lib/fullcalendar/packages/timegrid/main.js'></script>
    <script src='/assets/lib/fullcalendar/packages/list/main.js'></script>

    <script src="/assets/js/custom/pages/LeaveTestPage/Modal.js"></script>
    <script src="/assets/js/custom/pages/LeaveTestPage/Calendar.js"></script>
    <script>
        const initialEvents = @Html.Raw(Model.EventJson);
        const leaveRequests = @Html.Raw(Model.LeaveRequestsJson);
        const defaultDate = '@ViewData["SelectedDate"]';

        function callback(info){
            openLeaveModal(info.dateStr, leaveRequests);
        }

        initCalendar(initialEvents, callback, defaultDate);
    </script>
}

@section Styles {
    <style>
        :root {
            --fc-today-bg-color: #e0f2fe;
        }

        .fc-day-today {
            border: 2px solid #0ea5e9;
            border-radius: 8px;
        }

        .fc-daygrid-day:hover {
            background: #f8fafc;
            cursor: pointer;
            transition: 0.2s;
        }

        .fc-event:hover {
            transform: scale(1.02);
            transition: 0.2s;
        }
    </style>
}
