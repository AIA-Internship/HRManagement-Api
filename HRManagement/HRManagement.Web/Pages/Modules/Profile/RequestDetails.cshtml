@page "/Profile/RequestDetails"
@model HRManagement.Web.Pages.Modules.Profile.RequestDetailsModel
@{
    ViewData["Title"] = "Request Details";
}

<div class="main-content">
    <!-- Breadcrumb -->
    <nav class="mb-3">
        <nav style="--bs-breadcrumb-divider: '>';" aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0" style="font-size:13px;">
                <li class="breadcrumb-item">
                    <a href="#" class="text-decoration-none text-secondary">
                        Profile
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a href="/Profile/History" class="text-decoration-none text-secondary">
                        Request History
                    </a>
                </li>
                <li class="breadcrumb-item active fw-semibold" 
                    aria-current="page" 
                    style="color:#D31145;">
                    Request Details
                </li>
            </ol>
        </nav>
    </nav>

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h4 class="fw-bold mb-1">Personal Information</h4>
            <small class="text-muted">View and manage your personal information</small>
        </div>

        <a href="/Profile/Edit" class="btn btn-brand">
            <i class="bi bi-pencil me-2 text-white"></i>
            Edit Profile
        </a>
    </div>

    <!-- Placeholder Content from Raw Clone -->
    <div class="card shadow-sm mt-5">
        <div class="card-body p-10 text-center text-muted">
            <em>Request details content will be added here.</em>
        </div>
    </div>

</div>
