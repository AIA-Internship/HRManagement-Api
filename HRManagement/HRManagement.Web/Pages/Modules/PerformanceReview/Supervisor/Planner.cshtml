@page "/PerformanceReview/Supervisor/Planner"
@model HRManagement.Web.Pages.Modules.PerformanceReview.Supervisor.PlannerModel

@{
    ViewData["Title"] = "Planner";
}

@section Styles {
    <link rel="stylesheet" href="~/apps/modules/performance-review/css/planner-styles.css" asp-append-version="true" />
}

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div id="kt_app_content_container" class="app-container container-fluid px-5 px-lg-10">

            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="pt-4 pt-lg-6 mb-4">
                <ol class="breadcrumb text-muted fs-7 fw-semibold mb-0">
                    <li class="breadcrumb-item">Performance Review</li>
                    <li class="breadcrumb-item active text-brand" aria-current="page">Planner</li>
                </ol>
            </nav>

            <!-- Header -->
            <div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-end justify-content-between gap-4 mb-6 mb-lg-8">
                <div>
                    <h1 class="fw-bold text-gray-900 fs-3 mb-2">Planner</h1>
                    <p class="text-muted fs-6 mb-0">Build your review questions, set goals alongside minimum performance score, and schedule your review plans for the future.</p>
                </div>
                <button type="button"
                        class="btn btn-brand fw-semibold px-7 py-0 flex-shrink-0"
                        data-bs-toggle="modal"
                        data-bs-target="#newPlanModal">
                    <i class="bi bi-plus-lg me-2"></i>
                    New Plan
                </button>
            </div>

            <!-- Planner List -->
            <div id="plannerList" class="d-flex flex-column gap-2">
                <div class="card card-flush shadow-sm">
                    <div class="card-body text-center py-12">
                        <span class="spinner-border spinner-border-sm text-secondary me-2" role="status"></span>
                        <span class="text-muted fs-7">Loading plans...</span>
                    </div>
                </div>
            </div>

            <!-- Modal Create -->
            <div class="modal fade" id="newPlanModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-lg">
                    <div class="modal-content border-0 shadow">
                        <div class="modal-header border-0 px-8 pt-7 pb-3">
                            <div>
                                <h2 class="fw-bold text-gray-900 fs-4 mb-1">Create Performance Plan</h2>
                                <div class="text-muted fs-7">
                                    Choose how you want to create your plan.
                                </div>
                            </div>

                            <button type="button"
                                    class="btn btn-icon btn-sm btn-light"
                                    data-bs-dismiss="modal">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>

                        <div class="modal-body px-8 pb-8">
                            <div class="row g-4">

                                <div class="col-md-6">
                                    <button type="button"
                                            class="plan-create-option w-100 text-start"
                                            data-bs-dismiss="modal"
                                            onclick="goToCreatePlan()">
                                        <div class="plan-create-icon bg-light-primary text-primary">
                                            <i class="bi bi-plus-lg"></i>
                                        </div>

                                        <div class="fw-bold text-gray-900 fs-5 mt-4 mb-2">
                                            Create New Plan
                                        </div>

                                        <div class="text-muted fs-7">
                                            Start from scratch and configure a new performance review plan.
                                        </div>
                                    </button>
                                </div>

                                <div class="col-md-6">
                                    <button type="button"
                                            class="plan-create-option w-100 text-start"
                                            data-bs-dismiss="modal"
                                            onclick="openCopyPlanModal()">
                                        <div class="plan-create-icon bg-light-success text-success">
                                            <i class="bi bi-copy"></i>
                                        </div>

                                        <div class="fw-bold text-gray-900 fs-5 mt-4 mb-2">
                                            Copy Existing Plan
                                        </div>

                                        <div class="text-muted fs-7">
                                            Reuse an existing plan and create a new version with a different period.
                                        </div>
                                    </button>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Copy -->
            <div class="modal fade" id="copyPlanModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-lg">
                    <div class="modal-content border-0 shadow">

                        <div class="modal-header border-0 px-8 pt-7 pb-3">
                            <div>
                                <h2 class="fw-bold text-gray-900 fs-4 mb-1">Copy Performance Plan</h2>
                                <div class="text-muted fs-7">
                                    Select an existing plan and define the new plan period.
                                </div>
                            </div>

                            <button type="button"
                                    class="btn btn-icon btn-sm btn-light"
                                    data-bs-dismiss="modal">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>

                        <div class="modal-body px-8 pb-8">
                            <div id="copyPlanError"
                                 class="alert alert-danger d-none mb-5">
                            </div>

                            <div class="mb-5">
                                <label class="form-label fs-8 fw-bold text-muted text-uppercase">
                                    Source Plan
                                </label>

                                <select id="copySourcePlan"
                                        class="form-select form-select-solid fs-7">
                                    <option value="">Select plan to copy</option>
                                </select>

                                <div id="copySourcePlanError"
                                     class="text-danger fs-8 mt-2 d-none"></div>

                                <div class="text-muted fs-8 mt-2">
                                    Select the existing plan whose configuration you want to copy.
                                </div>
                            </div>

                            <div class="mb-5">
                                <label class="form-label fs-8 fw-bold text-muted text-uppercase">
                                    New Plan Name
                                </label>

                                <input id="copyPlanName"
                                       type="text"
                                       class="form-control form-control-solid fs-7"
                                       placeholder="e.g. 2027 Performance Review">

                                <div id="copyPlanNameError"
                                     class="text-danger fs-8 mt-2 d-none"></div>
                            </div>

                            <div class="row g-5">

                                <div class="col-md-4">
                                    <label class="form-label fs-8 fw-bold text-muted text-uppercase">
                                        Period Type
                                    </label>

                                    <select id="copyPeriodType"
                                            class="form-select form-select-solid fs-7"
                                            onchange="handleCopyPeriodChange()">
                                        <option value="">Select period type</option>
                                        <option value="Monthly">Monthly</option>
                                        <option value="Quarterly">Quarterly</option>
                                    </select>

                                    <div class="text-muted fs-8 mt-2">
                                        How often employees are reviewed.
                                    </div>

                                    <div id="copyPeriodTypeError"
                                         class="text-danger fs-8 mt-2 d-none"></div>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label fs-8 fw-bold text-muted text-uppercase">
                                        Starts From
                                    </label>

                                    <input id="copyStartDate"
                                           type="date"
                                           class="form-control form-control-solid fs-7"
                                           onchange="handleCopyDateChange()">

                                    <div class="text-muted fs-8 mt-2">
                                        The plan must start on the first day of a month.
                                    </div>

                                    <div id="copyStartDateError"
                                         class="text-danger fs-8 mt-2 d-none"></div>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label fs-8 fw-bold text-muted text-uppercase">
                                        Duration
                                    </label>

                                    <div class="input-group">
                                        <input id="copyDuration"
                                               type="number"
                                               min="1"
                                               step="1"
                                               class="form-control form-control-solid fs-7"
                                               placeholder="e.g. 12"
                                               oninput="handleCopyDateChange()">

                                        <span class="input-group-text bg-light border-0 fs-7">
                                            months
                                        </span>
                                    </div>

                                    <div id="copyDurationHelp"
                                         class="text-muted fs-8 mt-2">
                                        Select a period type to see the duration rules.
                                    </div>

                                    <div id="copyDurationError"
                                         class="text-danger fs-8 mt-2 d-none"></div>
                                </div>

                            </div>

                            <div id="copyEndDatePreview"
                                 class="d-none mt-4 p-3 bg-light-success rounded">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-calendar-check text-success"></i>
                                    <span id="copyEndDatePreviewText"
                                          class="text-success fw-semibold fs-8"></span>
                                </div>
                            </div>

                        </div>

                        <div class="modal-footer border-0 px-8 pb-7">
                            <button type="button"
                                    class="btn btn-light fw-bold"
                                    data-bs-dismiss="modal">
                                Cancel
                            </button>

                            <button type="button"
                                    id="copyPlanButton"
                                    class="btn btn-brand fw-bold"
                                    onclick="copyPlan()">
                                <span class="indicator-label">
                                    <i class="bi bi-copy me-1"></i>
                                    Copy Plan
                                </span>

                                <span class="indicator-progress d-none">
                                    Copying...
                                    <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                                </span>
                            </button>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Modal Delete -->
            <!-- Modal Delete -->
            <div class="modal fade" id="deletePlanModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-md">
                    <div class="modal-content planner-action-modal">

                        <div class="modal-header border-0 px-7 pt-7 pb-3">
                            <div>
                                <h2 class="fw-bold text-gray-900 fs-4 mb-1">
                                    Delete Performance Plan
                                </h2>
                                <div class="text-muted fs-7">
                                    Review this action before deleting the plan.
                                </div>
                            </div>

                            <button type="button"
                                    class="btn btn-icon btn-sm btn-light"
                                    data-bs-dismiss="modal">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>

                        <div class="modal-body px-7 pb-4">

                            <div class="planner-delete-warning mb-5">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="planner-delete-warning-icon">
                                        <i class="bi bi-exclamation-triangle"></i>
                                    </div>

                                    <div>
                                        <div class="fw-bold text-gray-800 fs-7 mb-1">
                                            This action cannot be undone
                                        </div>

                                        <div id="deletePlanMessage"
                                             class="text-muted fs-8">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div id="deletePlanError"
                                 class="alert alert-danger d-none mb-0 fs-8">
                            </div>

                        </div>

                        <div class="modal-footer border-0 px-7 pb-7 pt-2">
                            <button type="button"
                                    class="btn btn-light fw-bold"
                                    data-bs-dismiss="modal">
                                Cancel
                            </button>

                            <button type="button"
                                    id="deletePlanButton"
                                    class="btn btn-danger fw-bold"
                                    onclick="deletePlan()">
                                <i class="bi bi-trash me-1"></i>
                                Delete Plan
                            </button>
                        </div>

                    </div>
                </div>
            </div>


            <!-- Modal Activate -->
            <div class="modal fade" id="activatePlanModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-md">
                    <div class="modal-content planner-action-modal">

                        <div class="modal-header border-0 px-7 pt-7 pb-3">
                            <div>
                                <h2 class="fw-bold text-gray-900 fs-4 mb-1">
                                    Activate Performance Plan
                                </h2>
                                <div class="text-muted fs-7">
                                    Review the changes before activating this plan.
                                </div>
                            </div>

                            <button type="button"
                                    class="btn btn-icon btn-sm btn-light"
                                    data-bs-dismiss="modal">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>

                        <div class="modal-body px-7 pb-4">

                            <div class="planner-activate-warning mb-5">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="planner-activate-warning-icon">
                                        <i class="bi bi-exclamation-triangle"></i>
                                    </div>

                                    <div>
                                        <div class="fw-bold text-gray-800 fs-7 mb-1">
                                            You're about to change the active review plan
                                        </div>

                                        <div id="activatePlanMessage"
                                             class="text-muted fs-8">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="planner-activate-changes">
                                <div class="planner-activate-change">
                                    <i class="bi bi-arrow-repeat text-warning"></i>
                                    <div>
                                        <div class="fw-semibold text-gray-800 fs-8">
                                            Current ongoing plan
                                        </div>
                                        <div class="text-muted fs-8">
                                            Will be marked as Done.
                                        </div>
                                    </div>
                                </div>

                                <div class="planner-activate-change">
                                    <i class="bi bi-play-circle text-success"></i>
                                    <div>
                                        <div class="fw-semibold text-gray-800 fs-8">
                                            Selected plan
                                        </div>
                                        <div class="text-muted fs-8">
                                            Will become the new Ongoing plan.
                                        </div>
                                    </div>
                                </div>

                                <div class="planner-activate-change">
                                    <i class="bi bi-calendar-check text-primary"></i>
                                    <div>
                                        <div class="fw-semibold text-gray-800 fs-8">
                                            Review setup
                                        </div>
                                        <div class="text-muted fs-8">
                                            Review intervals and assignments will be generated
                                            using this plan's configuration.
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div id="activatePlanError"
                                 class="alert alert-danger d-none mt-5 mb-0 fs-8">
                            </div>

                        </div>

                        <div class="modal-footer border-0 px-7 pb-7 pt-2">
                            <button type="button"
                                    class="btn btn-light fw-bold"
                                    data-bs-dismiss="modal">
                                Cancel
                            </button>

                            <button type="button"
                                    id="activatePlanButton"
                                    class="btn btn-brand fw-bold"
                                    onclick="activatePlan()">
                                <i class="bi bi-play-circle me-1"></i>
                                Activate Plan
                            </button>
                        </div>

                    </div>
                </div>
            </div>

    </div>
</div>

@section Scripts {
    <script src="~/apps/modules/performance-review/js/planner.js" asp-append-version="true"></script>
}