@page "/PerformanceReview/Supervisor/PeerReviewDetails/{intervalId:int}/{subjectId:int}"
@model HRManagement.Web.Pages.Modules.PerformanceReview.Supervisor.PeerReviewModel
@{
    ViewData["Title"] = "Peer Review Details";
}

<style>
    :root {
        --background: #f9fafb;
        --card: #ffffff;
        --border: #e5e7eb;
        --foreground: #111827;
        --muted-foreground: #4b5563;
        --destructive: #dc2626; /* <-- Defined right here */
        --destructive-hover: #b91c1c; /* <-- Defined right here */
        --transparent-hover: #f1f5f9;
        --border-gray: #cbd5e1;
    }

    /* Matrix Grid Layout Styles */
    .matrix-grid-container {
        display: grid;
        width: 100%;
        min-width: 800px;
    }

    .matrix-grid-header {
        background-color: #f8f9fa;
        font-weight: 700;
        color: #4b5563;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 0.75rem 1rem;
        display: flex;
        align-items: center;
    }

    .matrix-grid-cell {
        padding: 1rem;
        background-color: #ffffff;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .matrix-question-text {
        font-weight: 600;
        color: #1f2937;
        font-size: 0.875rem;
    }

    /* --- MATCHED RATING BUTTON STYLES (Red Rectangles) --- */
    .rating-btn {
        width: 38px;
        height: 38px;
        border-radius: 0.375rem; /* rounded-3 equivalent */
        border: 1px solid #e5e7eb;
        background-color: #ffffff;
        color: #4b5563;
        font-size: 0.85rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.15s ease-in-out;
    }

        .rating-btn.active {
            background-color: var(--destructive) !important;
            color: #ffffff !important;
            border-color: var(--destructive) !important;
        }

        .rating-btn.interactive:hover {
            border-color: var(--destructive);
            color: var(--destructive);
            background-color: #fef2f2;
        }

    /* Peer Selection Badges */
    .peer-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.375rem 0.75rem;
        border-radius: 9999px;
        border: 1px solid #e5e7eb;
        font-size: 0.8125rem;
        font-weight: 500;
        cursor: pointer;
        user-select: none;
        transition: all 0.15s ease-in-out;
    }

        .peer-badge.matrix-selected {
            border-color: var(--destructive);
            background-color: #fef2f2;
            color: var(--destructive);
        }

    .peer-badge-check {
        font-weight: 700;
        font-size: 0.75rem;
    }

    .status-complete {
        border-left: 3px solid #10b981;
    }

    .status-partial {
        border-left: 3px solid #f59e0b;
    }

    /* Tab Switcher Styling matching AssignmentDetails */
    .nav-tab-btn {
        border-radius: 0.5rem;
        padding: 0.5rem 1rem;
        font-weight: 600;
        font-size: 0.85rem;
        border: 1px solid transparent;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        cursor: pointer;
    }

        .nav-tab-btn.active-tab {
            background-color: #fce8e6;
            color: var(--destructive);
            border-color: #f5c6cb;
        }

        .nav-tab-btn.inactive-tab {
            background-color: var(--destructive);
            color: #ffffff;
        }

            .nav-tab-btn.inactive-tab:hover {
                background-color: var(--destructive-hover);
            }

    .avatar-circle {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background-color: #f3f4f6;
        color: #4b5563;
        font-weight: 600;
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #e5e7eb;
    }

    .skeleton-placeholder {
        background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 50%, #f1f5f9 75%);
        background-size: 200% 100%;
        animation: loading 1.5s infinite;
        border-radius: 0.25rem;
    }

    @@keyframes loading {
        0% {
            background-position: 200% 0;
        }

        100% {
            background-position: -200% 0;
        }
    }
</style>

<div class="px-10">
    <!-- Breadcrumb -->
    <nav class="d-flex align-items-center gap-2 pt-6 mb-4 text-muted fs-7">
        <a href="/PerformanceReview/Supervisor/Assignments" class="breadcrumb-link d-flex align-items-center gap-1">
            <i class="ki-duotone ki-left fs-7"></i> Performance Review
        </a>
        <span class="text-gray-300">/</span>
        <a href="/PerformanceReview/Supervisor/Assignments" class="breadcrumb-link">Assignments</a>
        <span class="text-gray-300">/</span>
        <span class="text-gray-900 fw-semibold" id="breadcrumbSubject">Peer Review</span>
    </nav>

    <!-- Header Block -->
    <div class="mb-6">
        <h1 class="fw-bold text-gray-900 mb-2" id="assessmentTitle">PEER REVIEW</h1>
        <p class="text-muted fs-6 d-flex flex-wrap align-items-center gap-2" id="assessmentMeta">
            View aggregated peer review feedback and evaluate responses.
        </p>
    </div>

    <!-- Navigation Bar: Single Employee Dropdown -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-4 mb-6" id="topHeaderBar">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-white border border-gray-200 rounded-3 px-3 py-2 d-flex align-items-center gap-3 shadow-xs dropdown-container">
                <div class="avatar-circle" id="subjectInitials">--</div>
                <div class="d-flex flex-column w-100">
                    <label for="employeeSelect" class="text-muted fs-8 fw-semibold mb-1">EMPLOYEE</label>
                    <select id="employeeSelect" class="form-select form-select-sm border-0 p-0 fw-bold text-gray-900 fs-7 shadow-none" style="background-position: right 0 center;" onchange="onEmployeeChanged(this.value)">
                        <option value="">Loading employees...</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Tab Switcher Navigation -->
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="nav-tab-btn inactive-tab" onclick="navigateToSupervisorAssessment()">
                <i class="bi bi-clipboard-check fs-6"></i>
                <span>Supervisor Assignment</span>
            </button>
            <button type="button" class="nav-tab-btn active-tab">
                <i class="bi bi-people fs-6"></i>
                <span>Peer Review</span>
            </button>
            <button type="button" class="nav-tab-btn inactive-tab" onclick="navigateToSelfAssessment()">
                <i class="bi bi-person-badge fs-6"></i>
                <span>Self Assessment</span>
            </button>
        </div>
    </div>

    <!-- Reviewer Display Selector Badge Container -->
    <div id="reviewersHeaderCard" class="card p-6 bg-white shadow-sm border border-gray-100 mb-6 d-none">
        <div class="fs-7 fw-bold text-gray-400 text-uppercase mb-3 tracking-wider">
            Reviewer Display Checklist <span id="limitWarningLabel" class="limit-text-label">(Only <span id="dynamicLimitText">1-3</span> reviewers visible at once)</span>
        </div>
        <div id="reviewersBadgeContainer" class="d-flex flex-wrap gap-3"></div>
    </div>

    <!-- Skeleton Loader Placeholder -->
    <div id="matrixSkeleton" class="card p-8 bg-white shadow-sm border border-gray-100">
        <div class="skeleton-placeholder h-20px w-30 mb-4"></div>
        <div class="skeleton-placeholder h-40px w-100"></div>
    </div>

    <!-- Dynamic Matrix Container -->
    <div id="questionsWrapper" class="card bg-white border border-gray-100 shadow-sm rounded-lg d-none overflow-hidden">
        <div class="overflow-auto">
            <div id="matrixGrid" class="matrix-grid-container"></div>
        </div>
    </div>

    <!-- Page Action Buttons -->
    <div id="actionButtonsContainer" class="d-flex justify-content-end align-items-center gap-3 mt-6 mb-10">
        <button type="button" class="btn btn-secondary fw-bold" onclick="handleBack()">Kembali</button>
        <button type="button" class="btn btn-light-primary fw-bold" id="btnSaveDraft" onclick="submitAssessment(true)">
            <span class="indicator-label">Simpan Draft</span>
            <span class="indicator-progress d-none">
                Harap tunggu... <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
            </span>
        </button>
        <button type="button" class="btn btn-primary fw-bold" id="btnSubmit" onclick="submitAssessment(false)">
            <span class="indicator-label">Kirim Penilaian</span>
            <span class="indicator-progress d-none">
                Harap tunggu... <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
            </span>
        </button>
    </div>
</div>

@section Scripts {
    <script>
        const API_BASE = "https://localhost:7089";
        let currentIntervalId = null;
        let currentSubjectId = null;

        let peerReviewPayload = null;
        let selectedReviewerIds = [];
        let currentMaxVisible = 3;

        let supervisorRatings = {};

        document.addEventListener("DOMContentLoaded", async function () {
            const segments = window.location.pathname.split('/');
            currentSubjectId = parseInt(segments.pop(), 10) || 0;
            currentIntervalId = parseInt(segments.pop(), 10) || 0;

            setupBreakpointObserver();
            setupAutoResizeHandlers();

            if (currentIntervalId && currentSubjectId) {
                await fetchEmployeeList();
                await loadPeerReviewData(currentIntervalId, currentSubjectId);
            } else {
                renderEmptyState("Parameter rute tidak valid atau tidak lengkap.");
            }
        });

        function getAuthHeaders() {
            const token = window.aiaAuth && window.aiaAuth.getToken();
            if (!token) {
                window.aiaAuth && window.aiaAuth.signOut();
                return null;
            }
            return {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": `Bearer ${token}`
            };
        }

        async function fetchEmployeeList() {
            try {
                const headers = getAuthHeaders();
                if (!headers) return;

                const response = await fetch(`${API_BASE}/api/employee/regulars`, { method: "GET", headers });
                if (!response.ok) throw new Error("Gagal mengambil data karyawan.");

                const result = await response.json();
                if (result && !result.isError && Array.isArray(result.content)) {
                    renderEmployeeDropdown(result.content);
                }
            } catch (err) {
                console.error("Error fetching employees:", err);
            }
        }

        function renderEmployeeDropdown(employees) {
            const select = document.getElementById("employeeSelect");
            if (!employees.length) {
                select.innerHTML = `<option value="">Data kosong</option>`;
                return;
            }

            select.innerHTML = employees.map(e => `
                <option value="${e.id}" ${e.id == currentSubjectId ? 'selected' : ''}>
                    ${escapeHtml(e.fullName)}
                </option>
            `).join('');

            updateEmployeeAvatar();
        }

        async function onEmployeeChanged(newSubjectId) {
            if (!newSubjectId || newSubjectId == currentSubjectId) return;

            currentSubjectId = newSubjectId;
            updateEmployeeAvatar();

            window.history.pushState({}, '', `/PerformanceReview/Supervisor/PeerReviewDetails/${currentIntervalId}/${currentSubjectId}`);

            showSkeleton();
            await loadPeerReviewData(currentIntervalId, currentSubjectId);
        }

        function updateEmployeeAvatar() {
            const select = document.getElementById("employeeSelect");
            const selectedText = select.options[select.selectedIndex]?.text || "--";
            const cleanName = selectedText.split('(')[0].trim();
            document.getElementById("subjectInitials").innerText = getInitials(cleanName);
            document.getElementById("breadcrumbSubject").innerText = `Peer Review: ${cleanName}`;
        }

        async function loadPeerReviewData(intervalId, subjectId) {
            try {
                const headers = getAuthHeaders();
                if (!headers) return;

                const url = `${API_BASE}/api/assignment/intervals/${intervalId}/peer-reviews/subjects/${subjectId}`;
                const response = await fetch(url, { method: "GET", headers });

                if (!response.ok) throw new Error("Failed to load peer review responses.");

                const result = await response.json();
                hideSkeleton();

                if (!result || result.isError || !result.content) {
                    renderEmptyState("No peer review records found for this subject.");
                    return;
                }

                peerReviewPayload = result.content;
                
                // --- FILTER OUT REVIEWERS WITH NO ANSWERS SUBMITTED YET ---
                const rawReviewers = peerReviewPayload.reviewers || [];
                const submittedReviewers = rawReviewers.filter(r => Array.isArray(r.answers) && r.answers.length > 0);
                
                // Keep the filtered list in our working payload subset
                peerReviewPayload.filteredReviewers = submittedReviewers;

                try {
                    const actionContainer = document.getElementById("actionButtonsContainer");
                    const saveBtn = document.getElementById("btnSaveDraft");
                    const submitBtn = document.getElementById("btnSubmit");

                    const allCompleted = Boolean(peerReviewPayload.isAllCompleted);
                    const isSubmitted = Boolean(peerReviewPayload.isSubmitted);
                    const locked = allCompleted && isSubmitted;

                    if (actionContainer) {
                        actionContainer.classList.remove("d-none");
                        actionContainer.classList.add("d-flex");
                    }

                    if (locked || submittedReviewers.length === 0) {
                        if (saveBtn) saveBtn.classList.add("d-none");
                        if (submitBtn) submitBtn.classList.add("d-none");
                    } else {
                        if (saveBtn) saveBtn.classList.remove("d-none");
                        if (submitBtn) submitBtn.classList.remove("d-none");
                    }
                } catch (e) {
                    console.warn("Unable to toggle action button visibility:", e);
                }

                if (submittedReviewers.length === 0) {
                    renderEmptyState("Belum ada reviewer yang mengumpulkan jawaban peer review.");
                    document.getElementById("reviewersHeaderCard").classList.add("d-none");
                    return;
                }

                supervisorRatings = {};
                submittedReviewers.forEach(r => {
                    (r.answers || []).forEach(a => {
                        const validId = a.answerId ?? a.id;
                        const score = a.supervisorRating ?? a.reviewScore;

                        if (score !== null && score !== undefined && validId) {
                            supervisorRatings[`${a.questionId}_${r.fillerId}`] = Math.round(parseFloat(score));
                        }
                    });
                });

                selectedReviewerIds = submittedReviewers.slice(0, currentMaxVisible).map(r => r.fillerId);

                renderReviewersChecklist();
                renderMatrixGrid();
            } catch (err) {
                console.error("Error fetching peer reviews:", err);
                hideSkeleton();
                renderEmptyState("Terjadi kesalahan saat mengambil data peer review.");
            }
        }

        function renderReviewersChecklist() {
            const card = document.getElementById("reviewersHeaderCard");
            const container = document.getElementById("reviewersBadgeContainer");
            const reviewers = peerReviewPayload.filteredReviewers || [];

            container.innerHTML = "";

            reviewers.forEach(rev => {
                const isSelected = selectedReviewerIds.includes(rev.fillerId);
                const selectedClass = isSelected ? "matrix-selected" : "";

                const statusLower = (rev.status || "").toLowerCase();
                const statusClass = (statusLower === "scored" || statusLower === "done") ? "status-complete" : "status-partial";
                const checkMark = isSelected ? "✓" : "+";

                container.innerHTML += `
                    <div class="peer-badge ${statusClass} ${selectedClass}" onclick="toggleReviewerSelection(${rev.fillerId})">
                        <div class="peer-badge-check">${checkMark}</div>
                        <span>${escapeHtml(rev.fillerName)}</span>
                    </div>
                `;
            });

            card.classList.remove("d-none");
        }

        function toggleReviewerSelection(fillerId) {
            const idx = selectedReviewerIds.indexOf(fillerId);
            if (idx > -1) {
                if (selectedReviewerIds.length === 1) return;
                selectedReviewerIds.splice(idx, 1);
            } else {
                if (selectedReviewerIds.length >= currentMaxVisible) {
                    selectedReviewerIds.shift();
                }
                selectedReviewerIds.push(fillerId);
            }

            renderReviewersChecklist();
            renderMatrixGrid();
        }

        function renderMatrixGrid() {
            const gridContainer = document.getElementById("matrixGrid");
            const wrapper = document.getElementById("questionsWrapper");

            if (!gridContainer || !peerReviewPayload) return;

            const questions = peerReviewPayload.questions || [];
            const activeReviewers = (peerReviewPayload.filteredReviewers || []).filter(r => selectedReviewerIds.includes(r.fillerId));

            if (activeReviewers.length === 0 || questions.length === 0) {
                renderEmptyState("Data pertanyaan atau reviewer dengan jawaban tidak tersedia.");
                return;
            }

            const reviewerCount = activeReviewers.length;
            const colWidth = 72 / reviewerCount;
            gridContainer.style.gridTemplateColumns = `28% repeat(${reviewerCount}, ${colWidth}%)`;

            let html = `<div class="matrix-grid-header" style="border: 0.25px solid #e5e7eb">Questions</div>`;

            activeReviewers.forEach(r => {
                html += `
                    <div class="matrix-grid-header justify-content-center text-center" style="border: 0.25px solid #e5e7eb">
                        ${escapeHtml(r.fillerName).toUpperCase()}
                    </div>
                `;
            });

            const locked = Boolean(peerReviewPayload && peerReviewPayload.isAllCompleted && peerReviewPayload.isSubmitted);
            const sortedQuestions = [...questions].sort((a, b) => a.questionOrder - b.questionOrder);

            sortedQuestions.forEach(q => {
                html += `
                    <div class="matrix-grid-cell" style="border: 0.25px solid #e5e7eb">
                        <div class="matrix-question-text">${escapeHtml(q.questionText)}</div>
                    </div>
                `;

                activeReviewers.forEach(rev => {
                    const answerObj = (rev.answers || []).find(a => a.questionId === q.questionId);
                    const textValue = (answerObj?.textValue || "").trim();
                    const ratingValue = answerObj?.ratingValue;

                    if (q.questionType === "rating" || !textValue) {
                        let ratingButtonsHtml = "";
                        for (let i = 1; i <= 5; i++) {
                            const activeClass = (i === ratingValue) ? "active" : "";
                            ratingButtonsHtml += `<div class="rating-btn ${activeClass}" style="cursor: default; opacity: 0.85;">${i}</div>`;
                        }
                        html += `
                            <div class="matrix-grid-cell align-items-center justify-content-center" style="border: 0.25px solid #e5e7eb">
                                <div class="d-flex align-items-center justify-content-center gap-1">${ratingButtonsHtml}</div>
                            </div>
                        `;
                    } else {
                        const cellKey = `${q.questionId}_${rev.fillerId}`;
                        const currentSupRating = supervisorRatings[cellKey] ? Number(supervisorRatings[cellKey]) : null;

                        let supRatingButtonsHtml = "";
                        for (let i = 1; i <= 5; i++) {
                            const activeClass = (i === currentSupRating) ? "active" : "";
                            if (locked) {
                                supRatingButtonsHtml += `
                                    <div class="rating-btn ${activeClass}" style="cursor: default; opacity: 0.6;">
                                        ${i}
                                    </div>`;
                            } else {
                                supRatingButtonsHtml += `
                                    <div class="rating-btn interactive ${activeClass}"
                                         style="cursor: pointer;"
                                         onclick="setSupervisorRating(${q.questionId}, ${rev.fillerId}, ${i})">
                                        ${i}
                                    </div>`;
                            }
                        }

                        html += `
                            <div class="matrix-grid-cell" style="border: 0.25px solid #e5e7eb">
                                <textarea class="auto-grow form-control text-gray-600 fs-7 p-0 border-0 w-100 mb-4"
                                          style="min-height: 70px; resize: none; font-size: 0.85rem; background: transparent;"
                                          readonly>${escapeHtml(textValue)}</textarea>

                                <div class="d-flex align-items-center justify-content-center gap-2 mt-auto pt-2">
                                    ${supRatingButtonsHtml}
                                </div>
                            </div>
                        `;
                    }
                });
            });

            gridContainer.innerHTML = html;
            wrapper.classList.remove("d-none");
            autoGrowAllTextareas();
        }

        function setSupervisorRating(questionId, fillerId, rating) {
            const cellKey = `${questionId}_${fillerId}`;
            if (supervisorRatings[cellKey] === rating) {
                delete supervisorRatings[cellKey];
            } else {
                supervisorRatings[cellKey] = rating;
            }
            renderMatrixGrid();
        }

        function setupBreakpointObserver() {
            const mediaQuerySmall = window.matchMedia('(max-width: 767.98px)');
            const mediaQueryMedium = window.matchMedia('(min-width: 768px) and (max-width: 991.98px)');

            function handleBreakpointChange() {
                const limitTextEl = document.getElementById("dynamicLimitText");
                if (mediaQuerySmall.matches) {
                    currentMaxVisible = 1;
                    if (limitTextEl) limitTextEl.innerText = "1";
                } else if (mediaQueryMedium.matches) {
                    currentMaxVisible = 2;
                    if (limitTextEl) limitTextEl.innerText = "1-2";
                } else {
                    currentMaxVisible = 3;
                    if (limitTextEl) limitTextEl.innerText = "1-3";
                }

                if (selectedReviewerIds.length > currentMaxVisible) {
                    selectedReviewerIds = selectedReviewerIds.slice(-currentMaxVisible);
                    if (peerReviewPayload) {
                        renderReviewersChecklist();
                        renderMatrixGrid();
                    }
                }
            }

            mediaQuerySmall.addEventListener('change', handleBreakpointChange);
            mediaQueryMedium.addEventListener('change', handleBreakpointChange);
            handleBreakpointChange();
        }

        function setupAutoResizeHandlers() {
            const matrixGrid = document.getElementById("matrixGrid");
            if (matrixGrid) {
                matrixGrid.addEventListener("input", function (e) {
                    if (e.target.classList.contains("auto-grow")) adjustRowHeights(e.target);
                });
            }

            let resizeTimeout;
            window.addEventListener("resize", function () {
                clearTimeout(resizeTimeout);
                resizeTimeout = setTimeout(autoGrowAllTextareas, 150);
            });
        }

        function adjustRowHeights(textarea) {
            const matrixGrid = document.getElementById("matrixGrid");
            if (!matrixGrid || !textarea) return;

            const cell = textarea.closest('.matrix-grid-cell');
            if (!cell) return;

            const activeReviewers = (peerReviewPayload?.filteredReviewers || []).filter(r => selectedReviewerIds.includes(r.fillerId));
            const totalColumns = 1 + activeReviewers.length;

            const gridItems = Array.from(matrixGrid.children);
            const cellIndex = gridItems.indexOf(cell);
            if (cellIndex === -1) return;

            const rowIndex = Math.floor(cellIndex / totalColumns);
            const startRowIndex = rowIndex * totalColumns;
            const endRowIndex = startRowIndex + totalColumns;

            const rowItems = gridItems.slice(startRowIndex, endRowIndex);
            const rowTextareas = rowItems.map(item => item.querySelector('.auto-grow')).filter(t => t !== null);

            rowTextareas.forEach(t => { t.style.height = "auto"; });
            const maxHeight = Math.max(...rowTextareas.map(t => t.scrollHeight));
            rowTextareas.forEach(t => { t.style.height = maxHeight + "px"; });
        }

        function autoGrowAllTextareas() {
            setTimeout(() => {
                const textareas = document.querySelectorAll("#matrixGrid .auto-grow");
                textareas.forEach(t => adjustRowHeights(t));
            }, 100);
        }

        async function submitAssessment(isDraft) {
            const headers = getAuthHeaders();
            if (!headers || !peerReviewPayload) return;

            if (!isDraft) {
                const confirmed = confirm("Apakah Anda yakin ingin mengirim penilaian peer review ini?");
                if (!confirmed) return;
            }

            toggleSubmitLoading(true, isDraft);

            const reviewScores = [];
            const allReviewers = peerReviewPayload.filteredReviewers || [];

            Object.keys(supervisorRatings).forEach(key => {
                const parts = key.split('_');
                if (parts.length === 2) {
                    const questionId = parseInt(parts[0], 10);
                    const fillerId = parseInt(parts[1], 10);
                    const rawScore = supervisorRatings[key];

                    const reviewerObj = allReviewers.find(r => r.fillerId === fillerId);
                    if (reviewerObj) {
                        const answerObj = (reviewerObj.answers || []).find(a => a.questionId === questionId);
                        const answerId = answerObj?.answerId ?? answerObj?.id;

                        if (answerId !== undefined && answerId !== null && rawScore !== null && rawScore !== undefined) {
                            reviewScores.push({
                                assessmentAnswerId: parseInt(answerId, 10),
                                score: parseFloat(rawScore)
                            });
                        }
                    }
                }
            });

            const payload = {
                intervalId: currentIntervalId,
                subjectId: currentSubjectId,
                isDraft: isDraft,
                reviewScores: reviewScores
            };

            try {
                const response = await fetch(`${API_BASE}/api/assignment/peer-reviews/review`, {
                    method: "POST",
                    headers: headers,
                    body: JSON.stringify(payload)
                });

                const result = await response.json();

                if (!response.ok || result.isError) {
                    throw new Error(result.message || "Gagal menyimpan penilaian peer review.");
                }

                alert(isDraft ? "Draft penilaian peer review berhasil disimpan." : "Penilaian peer review berhasil dikirim.");

                if (!isDraft) {
                    window.location.href = "/PerformanceReview/Supervisor/Assignments";
                } else {
                    await loadPeerReviewData(currentIntervalId, currentSubjectId);
                }
            } catch (err) {
                console.error("Error submitting peer review ratings:", err);
                alert(err.message || "Terjadi kesalahan saat mengirim penilaian.");
            } finally {
                toggleSubmitLoading(false, isDraft);
            }
        }

        function toggleSubmitLoading(isLoading, isDraft) {
            const btn = isDraft ? document.getElementById("btnSaveDraft") : document.getElementById("btnSubmit");
            const otherBtn = isDraft ? document.getElementById("btnSubmit") : document.getElementById("btnSaveDraft");

            if (!btn) return;

            const label = btn.querySelector(".indicator-label");
            const progress = btn.querySelector(".indicator-progress");

            if (isLoading) {
                btn.setAttribute("disabled", "disabled");
                if (otherBtn) otherBtn.setAttribute("disabled", "disabled");
                label?.classList.add("d-none");
                progress?.classList.remove("d-none");
            } else {
                btn.removeAttribute("disabled");
                if (otherBtn) otherBtn.removeAttribute("disabled");
                label?.classList.remove("d-none");
                progress?.classList.add("d-none");
            }
        }

        function navigateToSupervisorAssessment() {
            window.location.href = `/PerformanceReview/Supervisor/AssignmentDetails/${currentIntervalId}/${currentSubjectId}`;
        }

        function navigateToSelfAssessment() {
            window.location.href = `/PerformanceReview/Supervisor/SelfAssessmentReview/${currentIntervalId}/${currentSubjectId}`;
        }

        function handleBack() {
            window.location.href = "/PerformanceReview/Supervisor/Assignments";
        }

        function getInitials(name) {
            if (!name) return "--";
            const parts = name.trim().split(" ");
            if (parts.length === 1) return parts[0].substring(0, 2).toUpperCase();
            return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
        }

        function renderEmptyState(message) {
            document.getElementById("matrixSkeleton")?.classList.add("d-none");
            document.getElementById("questionsWrapper")?.classList.add("d-none");
            document.getElementById("reviewersHeaderCard")?.classList.add("d-none");
            
            const gridContainer = document.getElementById("matrixGrid");
            if (gridContainer) {
                gridContainer.innerHTML = `<div class="p-8 text-center text-muted">${escapeHtml(message)}</div>`;
                document.getElementById("questionsWrapper")?.classList.remove("d-none");
            }
        }

        function showSkeleton() {
            document.getElementById("matrixSkeleton")?.classList.remove("d-none");
            document.getElementById("questionsWrapper")?.classList.add("d-none");
            document.getElementById("reviewersHeaderCard")?.classList.add("d-none");
        }

        function hideSkeleton() {
            document.getElementById("matrixSkeleton")?.classList.add("d-none");
        }

        function escapeHtml(str) {
            if (!str) return "";
            return String(str)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }
    </script>
}