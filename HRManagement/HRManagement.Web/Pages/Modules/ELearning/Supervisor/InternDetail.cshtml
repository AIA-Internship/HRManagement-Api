@page
@model HRManagement.Web.Pages.Modules.ELearning.Supervisor.InternDetailModel
@{
    ViewData["Title"] = "Intern Module Details";
}

@section Styles {
    <link href="/assets/plugins/custom/datatables/datatables.bundle.css" rel="stylesheet" />
    <link href="/apps/modules/elearning/css/supervisor/interns.css" rel="stylesheet" asp-append-version="true" />
    <link href="/apps/modules/elearning/css/supervisor/shared.css" rel="stylesheet" asp-append-version="true" />
}

<div class="d-flex flex-column flex-column-fluid">
    <!--begin::Toolbar-->
    <div id="kt_app_toolbar" class="app-toolbar py-3 py-lg-6">
        <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex flex-stack">
            <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
                <a href="/Modules/ELearning/Supervisor/Interns" class="btn btn-sm btn-light fw-bold align-self-start mb-3 d-inline-flex align-items-center"><i class="bi bi-arrow-left fs-5 me-1"></i>Back</a>
                <div class="el-breadcrumb">
                    <a href="/Modules/ELearning/Supervisor/Modules">E-Learning</a>
                    <span class="el-breadcrumb-sep">›</span>
                    <a href="/Modules/ELearning/Supervisor/Interns">Interns</a>
                    <span class="el-breadcrumb-sep">›</span>
                    <span class="el-breadcrumb-active">Module Details</span>
                </div>
            </div>
        </div>
    </div>
    <!--end::Toolbar-->

    <!--begin::Content-->
    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div id="kt_app_content_container" class="app-container container-fluid">

            <!--begin::Header-->
            <div class="d-flex justify-content-between align-items-start mb-6 flex-wrap gap-3 el-animate">
                <div class="d-flex align-items-center">
                    
                    <div>
                        <h1 class="fs-2 fw-bold text-gray-900 mb-1">Intern's Module Details</h1>
                        <h3 class="fw-normal text-muted mb-0 fs-6" id="el-sv-intern-name"></h3>
                    </div>
                </div>
            </div>
            <!--end::Header-->

            <!--begin::Filters-->
            <div class="d-flex align-items-center gap-4 mb-6 flex-wrap el-animate el-animate-delay-1" style="position: relative; z-index: 20;">
                <!--begin::Custom Batch Dropdown-->
                <div class="el-sv-custom-dropdown w-200px" id="el-sv-intern-batch-dropdown">
                    <button class="el-sv-dropdown-toggle w-100" type="button" id="el-sv-intern-batch-toggle">
                        <span class="el-sv-dropdown-text" id="el-sv-intern-batch-text">All Batches</span>
                        <i class="ki-duotone ki-down fs-5 ms-1"></i>
                    </button>
                    <div class="el-sv-dropdown-menu w-100" id="el-sv-intern-batch-menu">
                        <div class="el-sv-dropdown-item active" data-value="">All Batches</div>
                        <!--Populated by JS-->
                    </div>
                </div>
                <input type="hidden" id="el-sv-intern-batch" value="" />
                <!--end::Custom Batch Dropdown-->

                <!--begin::Custom Status Dropdown-->
                <div class="el-sv-custom-dropdown w-200px" id="el-sv-intern-status-dropdown">
                    <button class="el-sv-dropdown-toggle w-100" type="button" id="el-sv-intern-status-toggle">
                        <span class="el-sv-dropdown-text" id="el-sv-intern-status-text">All Statuses</span>
                        <i class="ki-duotone ki-down fs-5 ms-1"></i>
                    </button>
                    <div class="el-sv-dropdown-menu w-100" id="el-sv-intern-status-menu">
                        <div class="el-sv-dropdown-item active" data-value="">All Statuses</div>
                        <div class="el-sv-dropdown-item" data-value="Not Started">Not Started</div>
                        <div class="el-sv-dropdown-item" data-value="In Progress">In Progress</div>
                        <div class="el-sv-dropdown-item" data-value="Completed">Completed</div>
                        <div class="el-sv-dropdown-item" data-value="Failed">Failed</div>
                    </div>
                </div>
                <input type="hidden" id="el-sv-intern-status" value="" />
                <!--end::Custom Status Dropdown-->
            </div>
            <!--end::Filters-->

            <!--begin::Grid-->
            <div class="row el-animate el-animate-delay-2" id="el-sv-intern-detail-grid">
                <!--Rendered by JS-->
            </div>
            <!--end::Grid-->

        </div>
    </div>
    <!--end::Content-->
</div>

@section Scripts {
    <script src="/apps/modules/elearning/js/elearning-guard.js" asp-append-version="true"></script>
    <script src="/assets/plugins/custom/datatables/datatables.bundle.js"></script>
    <script src="/apps/modules/elearning/js/supervisor/interndetail.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            if (window.app && window.app.elearning && window.app.elearning.supervisor) {
                app.elearning.supervisor.interndetail.init();
            }
        });
    </script>
}
