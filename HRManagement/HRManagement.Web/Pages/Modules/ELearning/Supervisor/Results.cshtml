@page
@model HRManagement.Web.Pages.Modules.ELearning.Supervisor.ResultsModel
@{
    ViewData["Title"] = "Results";
}

@section Styles {
    <link href="/assets/plugins/custom/datatables/datatables.bundle.css" rel="stylesheet" />
    <link href="/apps/modules/elearning/css/supervisor/results.css" rel="stylesheet" asp-append-version="true" />
    <link href="/apps/modules/elearning/css/supervisor/shared.css" rel="stylesheet" asp-append-version="true" />
}

<div class="d-flex flex-column flex-column-fluid">
    <!--begin::Toolbar-->
    <div id="kt_app_toolbar" class="app-toolbar py-3 py-lg-6">
        <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex flex-stack">
            <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
                <button onclick="history.back()" class="btn btn-sm btn-light fw-bold align-self-start mb-3 d-inline-flex align-items-center" type="button"><i class="bi bi-arrow-left fs-5 me-1"></i>Back</button>
                <div class="el-breadcrumb">
                    <a href="/Modules/ELearning/Supervisor/Modules">E-Learning</a>
                    <span class="el-breadcrumb-sep">›</span>
                    <span class="el-breadcrumb-active">Modules</span>
                </div>
            </div>
        </div>
    </div>
    <!--end::Toolbar-->

    <!--begin::Content-->
    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div id="kt_app_content_container" class="app-container container-fluid">

            <!--begin::Header-->
            <div class="d-flex align-items-center mb-6 el-animate">
                
                <h1 class="fs-2 fw-bold text-gray-900 mb-0">Results</h1>
            </div>
            <!--end::Header-->

            <!--begin::Header + Badge-->
            <div class="d-flex align-items-center gap-3 mb-6 el-animate el-animate-delay-1">
                <span class="el-sv-submitted-badge" id="el-sv-results-count">0 / 0 Submitted</span>
            </div>
            <!--end::Header + Badge-->

            <!--begin::Table Card-->
            <div class="card shadow-sm el-animate el-animate-delay-2">
                <div class="card-body p-6">
                    <div class="table-responsive">
                        <table class="table align-middle fs-6 gy-3 mb-0" id="el-sv-results-table">
                            <thead>
                                <!-- Columns populated by JS per tab -->
                            </thead>
                            <tbody>
                                <!--Rendered by DataTables-->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <!--end::Table Card-->

        </div>
    </div>
    <!--end::Content-->
</div>

@section Scripts {
    <script src="/apps/modules/elearning/js/elearning-guard.js" asp-append-version="true"></script>
    <script src="/assets/plugins/custom/datatables/datatables.bundle.js"></script>
    <script src="/apps/modules/elearning/js/supervisor/results.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            if (window.app && window.app.elearning && window.app.elearning.supervisor) {
                app.elearning.supervisor.results.init();
            }
        });
    </script>
}
