@page
@model HRManagement.Web.Pages.Modules.ELearning.Intern.DocumentViewerModel
@{
    ViewData["Title"] = "Document Viewer";
}

@section Styles {
    <link href="/apps/modules/elearning/css/intern/viewer.css" rel="stylesheet" asp-append-version="true" />
}

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_content" class="app-content flex-column-fluid p-0">
        
        <!--begin::Document Viewer Wrapper-->
        <div class="el-doc-wrapper el-animate">
            
            <!--begin::Sidebar (Thumbnails)-->
            <div class="el-doc-sidebar">
                <div class="fs-6 fw-bold text-gray-800 mb-4">Pages</div>
                
                <div class="el-doc-thumbnail active">
                    <!-- Placeholder for page thumbnail -->
                    <div class="bg-light w-75 h-75 rounded d-flex flex-column p-2 shadow-sm">
                        <div class="bg-secondary w-50 h-5px mb-2 rounded"></div>
                        <div class="bg-secondary w-75 h-5px mb-2 rounded"></div>
                        <div class="bg-secondary w-100 h-5px mb-2 rounded"></div>
                        <div class="bg-secondary w-25 h-20px mt-auto mx-auto rounded"></div>
                    </div>
                </div>
                <div class="el-doc-thumbnail-label text-primary fw-bold">1</div>

                <div class="el-doc-thumbnail">
                    <div class="bg-light w-75 h-75 rounded d-flex flex-column p-2 shadow-sm">
                        <div class="bg-secondary w-100 h-25px mb-2 rounded"></div>
                        <div class="bg-secondary w-100 h-5px mb-2 rounded"></div>
                        <div class="bg-secondary w-100 h-5px mb-2 rounded"></div>
                    </div>
                </div>
                <div class="el-doc-thumbnail-label">2</div>

                <div class="el-doc-thumbnail">
                    <div class="bg-light w-75 h-75 rounded d-flex flex-column p-2 shadow-sm">
                        <div class="bg-secondary w-100 h-5px mb-2 rounded"></div>
                        <div class="bg-secondary w-100 h-5px mb-2 rounded"></div>
                    </div>
                </div>
                <div class="el-doc-thumbnail-label">3</div>
            </div>
            <!--end::Sidebar-->

            <!--begin::Main Content-->
            <div class="d-flex flex-column flex-row-fluid">
                
                <!--begin::Toolbar-->
                <div class="el-doc-toolbar">
                    <a href="/Modules/ELearning/Intern/Modules" class="btn btn-sm btn-light btn-active-light-primary text-gray-600 fw-bold">
                        <i class="ki-duotone ki-arrow-left fs-5"><span class="path1"></span><span class="path2"></span></i> Back to Modules
                    </a>

                    <div class="el-doc-pagination">
                        <button title="First Page"><i class="ki-duotone ki-black-left fs-6"><span class="path1"></span></i></button>
                        <button title="Previous Page"><i class="ki-duotone ki-left fs-6"><span class="path1"></span></i></button>
                        <input type="text" value="1" readonly />
                        <span class="fs-8 text-gray-500 fw-bold px-1">/ 14</span>
                        <button title="Next Page"><i class="ki-duotone ki-right fs-6"><span class="path1"></span></i></button>
                        <button title="Last Page"><i class="ki-duotone ki-black-right fs-6"><span class="path1"></span></i></button>
                        
                        <div class="vr mx-2 bg-gray-300"></div>
                        
                        <button title="Zoom Out"><i class="ki-duotone ki-minus fs-6"><span class="path1"></span></i></button>
                        <span class="fs-8 text-gray-700 fw-bold px-2">100%</span>
                        <button title="Zoom In"><i class="ki-duotone ki-plus fs-6"><span class="path1"></span></i></button>
                    </div>

                    <div class="d-flex align-items-center text-end">
                        <div class="me-4">
                            <div class="fs-6 fw-bold text-gray-900">Employee Handbook 2024.pdf</div>
                            <div class="fs-8 text-gray-500">Human Resources • Updated Oct 12</div>
                        </div>
                        <button class="btn btn-icon btn-sm btn-light btn-active-light-primary me-2" title="Download">
                            <i class="ki-duotone ki-file-down fs-3"><span class="path1"></span><span class="path2"></span></i>
                        </button>
                        <button class="btn btn-icon btn-sm btn-light btn-active-light-primary" title="Print">
                            <i class="ki-duotone ki-printer fs-3"><span class="path1"></span><span class="path2"></span><span class="path3"></span><span class="path4"></span><span class="path5"></span></i>
                        </button>
                    </div>
                </div>
                <!--end::Toolbar-->

                <!--begin::Page View-->
                <div class="el-doc-main bg-secondary">
                    <div class="el-doc-page el-animate el-animate-delay-1">
                        
                        <div class="d-flex justify-content-between mb-10">
                            <div class="bg-light rounded w-150px h-30px"></div>
                            <div class="text-gray-400 fs-7">Confidential</div>
                        </div>

                        <h1 class="fw-bolder text-gray-900 fs-2hx mb-3">Employee Handbook</h1>
                        <h2 class="fw-normal text-gray-500 fs-2 mb-10">Policies & Guidelines for 2024</h2>

                        <div class="w-100 h-10px bg-light rounded mb-4"></div>
                        <div class="w-100 h-10px bg-light rounded mb-4"></div>
                        <div class="w-75 h-10px bg-light rounded mb-4"></div>
                        <div class="w-100 h-10px bg-light rounded mb-4"></div>
                        <div class="w-100 h-10px bg-light rounded mb-4"></div>
                        <div class="w-50 h-10px bg-light rounded mb-10"></div>

                        <div class="w-100 h-250px bg-light rounded d-flex align-items-center justify-content-center border border-dashed border-gray-300">
                            <i class="ki-duotone ki-picture fs-5x text-gray-300"><span class="path1"></span><span class="path2"></span></i>
                        </div>

                    </div>
                </div>
                <!--end::Page View-->

            </div>
            <!--end::Main Content-->

        </div>
        <!--end::Document Viewer Wrapper-->

    </div>
</div>

@section Scripts {
    <script src="/apps/modules/elearning/js/elearning-guard.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            $('#kt_app_header').hide();
            $('#kt_app_sidebar').hide();
        });
    </script>
}
