@page "/Leave/Employee/Dashboard"
@model HRManagement.Web.Pages.Modules.Leave.Employee.HomepageModel
@{
    ViewData["Title"] = "Leave Dashboard";
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/tom-select/dist/css/tom-select.css" rel="stylesheet">
    <link rel="stylesheet" href="~/apps/modules/leave/css/dashboard.css" asp-append-version="true" />
    <style>
        #leaveTableBody tr:hover {
            background-color: #dc3545 !important;
            color: #fff !important;
        }
        #leaveTableBody tr:hover td {
            color: #fff !important;
        }
        #leaveTableBody tr:hover .badge {
            color: #fff !important;
            opacity: 1 !important;
        }
        #leaveTableBody td {
            padding: 1.1rem 2rem; 
            vertical-align: middle; 
        }
        #leaveTableBody tr {
            box-sizing: border-box;
        }
    </style>
}

<div class="mx-11">
    @await Html.PartialAsync("Layout/_PageHeader", new PageHeaderViewModel
    {
        Title = "Leave",
        Subtitle = "Overview of your leave status and activity",
        Breadcrumbs = new List<BreadcrumbItem> {
            new BreadcrumbItem { Title = "Leave", Url = "/Leave/Employee/Dashboard" },
            new BreadcrumbItem { Title = "Dashboard" }
        },
    })
</div>

<div class="container-fluid px-5">
    <div class="row mb-4 mx-3">
        <div class="col">
            <h2 class="fw-bold">Hello, Richardson, Alex</h2>
            <p class="text-muted">Here is an overview of your leave status and activity</p>
        </div>
    </div>

    <div class="d-flex flex-wrap align-items-stretch mb-2">
        <div class="flex-fill mx-5 mb-5" style="max-width:30rem; min-width:0;">
            <div class="card text-white bg-danger h-70" style="min-width:0;">
                <div class="card-body d-flex align-items-center">
                    <div>
                        <small class="d-block fs-3 fw-bold">Total Leave Quota
                        <i class="bi bi-info-circle text-white ms-2" tabindex="0" role="button"
                               data-bs-toggle="popover"
                               data-bs-trigger="hover focus"
                               data-bs-placement="right"
                               data-bs-html="true"
                               data-bs-custom-class="info-popover"
                               data-bs-content="<ul><li>Leave Quota will increase by 1 every month on the 1st at 00:00.</li><li>Leave Quota can go below 0 (you may use it even when the quota is negative).</li></ul>">
                        </i>
                        </small>
                        <div class="d-flex align-items-center">
                                <div class="d-flex me-3 fw-bolder" style="font-size:6rem;line-height:1.2;">
                                    <span id="leaveBalance">-</span>
                                </div>
                                <div class="d-flex flex-column">
                                    <span class="fw-bold mt-6" style="font-size:2rem; line-height:1.2;">
                                        Days
                                    </span>
                                    <small class="">Remaining</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        <div class="flex-fill mx-4 mb-4" style="max-width:30rem; min-width:0;">
            <div class="card h-70" style="min-width:0;">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="me-3">
                            <h6 class="mb-0 mt-2">Leave Distribution</h6>
                        </div>
                    </div>
                    <div class="mb-6 mt-5">

                        <div class="d-flex justify-content-between mb-1">
                            <small>
                                Paid Leave
                                <i class="bi bi-info-circle ms-1 text-secondary" style="font-size: 0.8rem;color:#0f172a !important"
                                   tabindex="0"
                                   role="button"
                                   data-bs-toggle="popover"
                                   data-bs-trigger="hover focus"
                                   data-bs-placement="right"
                                   data-bs-html="true"
                                   data-bs-custom-class="info-popover"
                                   data-bs-content="
                                    <strong>Leave with pay: </strong>
                                    Your salary remains unchanged during the leave period.
                                    ">
                                </i>
                            </small>

                            <small id="paidCount">0</small>
                        </div>

                        <div class="progress" style="height:8px;">
                            <div id="paidBar" class="progress-bar bg-danger" role="progressbar"></div>
                        </div>

                    </div>


                    <div class="mb-1">

                        <div class="d-flex justify-content-between mb-1">
                            <small>
                                Unpaid Leave
                                <i class="bi bi-info-circle ms-1 text-secondary" style="font-size: 0.8rem; color:#0f172a !important"
                                   tabindex="0"
                                   role="button"
                                   data-bs-toggle="popover"
                                   data-bs-trigger="hover focus"
                                   data-bs-placement="right"
                                   data-bs-html="true"
                                   data-bs-custom-class="info-popover"
                                   data-bs-content="
                                    <strong>Leave without pay: </strong>
                                    your salary may be reduced for the leave period.
                                   ">
                                </i>
                            </small>

                            <small id="unpaidCount">0</small>
                        </div>

                        <div class="progress" style="height:8px;">
                            <div id="unpaidBar" class="progress-bar bg-danger" role="progressbar"></div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mx-10 mb-15">
    <div class="card-body ps-0 pe-0">
        <div class="d-flex align-items-center justify-content-between mb-3 px-4" style="overflow-y: hidden; overflow: visible;">
            <div>
                <div class="leave-filter ms-7">
                    <button class="filter-btn active" data-status="pending">
                        Needs Approval
                    </button>

                    <button class="filter-btn" data-status="approved">
                        Approved
                    </button>

                    <button class="filter-btn" data-status="rejected">
                        Rejected
                    </button>
                </div>
            </div>

            <div class="d-flex align-items-center flex-shrink-0"
                 style="gap:1rem;">
                <label class="me-2">Sort By:</label>
                
                <div class="sort-select">
                    <select id="sortSelect">
                        <option value="newest">Newest</option>
                        <option value="oldest">Oldest</option>
                    </select>

                    <i class="bi bi-chevron-down"></i>
                </div>

                <a href="/Leave/Employee/NewRequest"
                       class="btn btn-danger d-flex align-items-center justify-content-center"
                       style="
                    height:2.7rem;
                    min-width:11rem;
                    white-space:nowrap;
                    text-align:center;
                    ">
                    + New request
                </a>
            </div>

        </div>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                    <th class="px-7"><strong>Leave Type</strong></th>
                    <th class="px-7"><strong>Start Date</strong></th>
                    <th class="px-7"><strong>End Date</strong></th>
                    <th class="px-7"><strong>Duration</strong></th>
                        <th class="px-7 text-center"><strong>Status</strong></th>
                    </tr>
                </thead>
                <tbody id="leaveTableBody">
                    <tr>
                        <td colspan="5" class="text-center text-muted">Loading...</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="d-flex align-items-center justify-content-between mt-3 ms-7 me-7">
            <div class="text-muted" id="showingText">Showing 0-0 of 0 requests</div>
            <nav aria-label="pagination">
                <ul class="pagination mb-0" id="paginationList">
                </ul>
            </nav>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/tom-select/dist/js/tom-select.complete.min.js"></script>
    <script src="~/apps/modules/leave/js/dashboard.js" asp-append-version="true"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            try {
                new TomSelect('#sortSelect', {
                    create: false,
                    allowEmptyOption: false,
                    searchField: [],
                    controlInput: null,
                    maxOptions: null,
                    dropdownParent: 'body'
                });
            } catch (e) {
                console.warn('TomSelect init failed', e);
            }

            const u = window.aiaAuth ? window.aiaAuth.getUserInfo() : null;
            const nameEl = document.querySelector('h2.fw-bold');
            if (u && (u.fullName || u.name) && nameEl) {
                nameEl.textContent = 'Hello, ' + (u.fullName || u.name);
            }
        });
    </script>
}