@page "/Leave/Employee/Dashboard"
@model HRManagement.Web.Pages.Modules.Leave.Employee.HomepageModel
@{
    ViewData["Title"] = "Leave Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/apps/modules/leave/css/dashboard.css" asp-append-version="true" />
    <style>
        #leaveTableBody tr:hover {
            background-color: #dc3545 !important;
            color: #fff !important;
        }
        #leaveTableBody tr:hover td {
            color: #fff !important;
        }
        #leaveTableBody tr:hover .badge {
            color: #fff !important;
            opacity: 1 !important;
        }
    </style>
}

<div class="mx-11">
    @await Html.PartialAsync("Layout/_PageHeader", new PageHeaderViewModel
    {
        Title = "Leave",
        Subtitle = "Overview of your leave status and activity",
        Breadcrumbs = new List<BreadcrumbItem> {
            new BreadcrumbItem { Title = "Leave", Url = "/Leave/Employee/Dashboard" },
            new BreadcrumbItem { Title = "Dashboard" }
        },
    })
</div>

<div class="container-fluid px-5">
    <div class="row mb-4 mx-3">
        <div class="col">
            <h2 class="fw-bold">Hello, Richardson, Alex</h2>
            <p class="text-muted">Here is an overview of your leave status and activity</p>
        </div>
    </div>

    <div class="d-flex flex-wrap align-items-stretch mb-2">
        <div class="flex-fill mx-5 mb-5" style="max-width:30rem; min-width:30rem;">
            <div class="card text-white bg-danger h-70" style="min-width:0;">
                <div class="card-body d-flex align-items-center">
                    <div>
                        <small class="d-block fs-3 fw-bold">Total Leave Quota
                        <i class="bi bi-info-circle text-white ms-2" tabindex="0" role="button"
                               data-bs-toggle="popover"
                               data-bs-trigger="hover focus"
                               data-bs-placement="right"
                               data-bs-html="true"
                               data-bs-custom-class="info-popover"
                               data-bs-content="<ul><li><strong>Leave Quota will increase by 1 every month on the 1st at 00:00.</strong></li><li><strong>Leave Quota can go below 0 (you may use it even when the quota is negative).</strong></li></ul>">
                        </i>
                        </small>
                        <div class="d-flex align-items-center">
                            <div class="d-flex me-3 fw-bolder" style="font-size:6rem;line-height:1.2;">
                                @Model.LeaveBalance
                            </div>
                            <div class="d-flex flex-column">
                                <span class="fw-bold mt-6" style="font-size:2rem; line-height:1.2;">
                                    Days
                                </span>
                                <small class="">Remaining</small>
                            </div>
                        </div>
                        </div>
                    </div>
                </div>
            </div>

        <div class="flex-fill mx-5 mb-4" style="max-width:30rem; min-width:30rem;">
            <div class="card h-70" style="min-width:0;">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="me-3">
                            <h6 class="mb-0">Leave Distribution</h6>
                        </div>
                    </div>

                    <div class="mb-2">
                        
                        <div class="d-flex justify-content-between">
                            <small>Personal</small>
                            <small>@Model.LeaveTypeCount.annualLeave</small>
                        </div>
                        <div class="progress" style="height:6px;">
                            <div id="personalBar" class="progress-bar bg-danger" role="progressbar"></div>
                        </div>

                    </div>
                    <div class="mb-2">
                        <div class="d-flex justify-content-between">
                            <small>Sick</small>
                            <small>@Model.LeaveTypeCount.sickLeave</small>
                        </div>

                        <div class="progress" style="height:6px;">
                            <div id="sickBar" class="progress-bar bg-danger" role="progressbar"></div>
                        </div>

                    </div>
                    <div class="mb-2">
                        <div class="d-flex justify-content-between">
                            <small>Emergency</small>
                            <small>@Model.LeaveTypeCount.emergencyLeave</small>
                        </div>

                        <div class="progress" style="height:6px;">
                            <div id="emergencyBar" class="progress-bar bg-danger bg-opacity-25" role="progressbar"></div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mx-10 mb-15">
    <div class="card-body ps-0 pe-0">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <div class="btn-group ms-7" role="group" aria-label="filters">
                    <button class="btn btn-outline-secondary active">Needs Approval</button>
                    <button class="btn btn-outline-secondary">Approved</button>
                    <button class="btn btn-outline-secondary">Rejected</button>
                </div>
            </div>
            <div class="d-flex align-items-center me-7">
                <label class="me-2">Sort By:</label>
                <select class="form-select form-select-sm me-3" style="width:160px;">
                    <option selected>newest</option>
                    <option>oldest</option>
                </select>
                <a class="btn btn-danger">+ New request</a>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                    <th class="px-7"><strong>Leave Type</strong></th>
                    <th class="px-7"><strong>Start Date</strong></th>
                    <th class="px-7"><strong>End Date</strong></th>
                    <th class="px-7"><strong>Duration</strong></th>
                    <th class="px-7"><strong>Status</strong></th>
                    </tr>
                </thead>
                <tbody id="leaveTableBody">
                    @if (Model.PagedRequests != null && Model.PagedRequests.Count > 0)
                    {
                        foreach (var req in Model.PagedRequests)
                        {
                            <tr>
                                <td style="padding-left:2rem; padding-right:2rem;">@req.LeaveType</td>
                                <td style="padding-left:2rem; padding-right:2rem;">@req.StartDate.ToString("dddd, d MMMM yyyy")</td>
                                <td style="padding-left:2rem; padding-right:2rem;">@req.EndDate.ToString("dddd, d MMMM yyyy")</td>
                                <td style="padding-left:2rem; padding-right:2rem;">@req.DurationDays @(req.DurationDays > 1 ? "Days" : "Day")</td>
                                <td>
                                    @{
                                        var status = req.Status ?? string.Empty;
                                        if (status.Equals("Approved", System.StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="d-inline-flex align-items-center justify-content-center gap-1 text-center" style="height:2rem; width:8rem; color:#065F46; background-color:#D1FAE5">
                                                <i class="bi bi-check-circle" style="color:#2B8B15"></i>
                                                <Strong>Approved</Strong>
                                            </span>
                                        }
                                        else if (status.Equals("Rejected", System.StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-danger">Rejected</span>;
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Needs Approval</span>;
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted">No leave requests found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex align-items-center justify-content-between mt-3 ms-7 me-7">
            <div class="text-muted" id="showingText">Showing @Model.StartItem-@Model.EndItem of @Model.TotalItems requests</div>
            <nav aria-label="pagination">
                <ul class="pagination mb-0" id="paginationList">
                    @{ 
                        var prevPage = Model.CurrentPage - 1;
                        var nextPage = Model.CurrentPage + 1;
                        var prevDisabled = Model.CurrentPage <= 1;
                        var nextDisabled = Model.CurrentPage >= Model.TotalPages;
                    }
                    <li class="@(prevDisabled ? "page-item disabled" : "page-item")">
                        <a class="page-link" data-page="@(prevDisabled ? Model.CurrentPage : prevPage)" href="#" aria-label="Previous">&laquo;</a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="@(i == Model.CurrentPage ? "page-item active" : "page-item")"><a class="page-link" data-page="@i" href="#">@i</a></li>
                    }
                    <li class="@(nextDisabled ? "page-item disabled" : "page-item")">
                        <a class="page-link" data-page="@(nextDisabled ? Model.CurrentPage : nextPage)" href="#" aria-label="Next">&raquo;</a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const sick = @Model.LeaveTypeCount.sickLeave;
        const personal = @Model.LeaveTypeCount.annualLeave;
        const emergency = @Model.LeaveTypeCount.emergencyLeave;
    </script>
    <script src="~/apps/modules/leave/js/dashboard.js" asp-append-version="true"></script>
    <script>
        // handle pagination clicks and fetch paged data without full page reload
        (function () {
            const paginationList = document.getElementById('paginationList');
            const tableBody = document.getElementById('leaveTableBody');
            const showingText = document.getElementById('showingText');

            if (!paginationList || !tableBody || !showingText) {
                // required elements not found; nothing to do
                return;
            }

            function renderRows(items) {
                if (!items || items.length === 0) {
                    tableBody.innerHTML = '<tr><td colspan="5" class="text-center text-muted">No leave requests found.</td></tr>';
                    return;
                }

                tableBody.innerHTML = items.map(i => {
                    const badge = (function (status) {
                        if (!status) return '<span class="badge bg-warning text-dark">Needs Approval</span>';
                        const s = status.toLowerCase();
                        if (s === 'approved') return '<span class="badge bg-success">Approved</span>';
                        if (s === 'rejected') return '<span class="badge bg-danger">Rejected</span>';
                        return '<span class="badge bg-warning text-dark">Needs Approval</span>';
                    })(i.status);

                    return `
                        <tr>
                            <td>${i.leaveType}</td>
                            <td>${i.startDate}</td>
                            <td>${i.endDate}</td>
                            <td>${i.duration} ${i.duration > 1 ? 'Days' : 'Day'}</td>
                            <td>${badge}</td>
                        </tr>`;
                }).join('');
            }

            function renderPagination(meta) {
                const { currentPage, totalPages } = meta;
                const prevDisabled = currentPage <= 1;
                const nextDisabled = currentPage >= totalPages;

                // Show a sliding window of numeric page buttons (maxButtons)
                const maxButtons = 3;
                let startPage = Math.max(1, currentPage - Math.floor(maxButtons / 2));
                let endPage = startPage + maxButtons - 1;
                if (endPage > totalPages) {
                    endPage = totalPages;
                    startPage = Math.max(1, endPage - maxButtons + 1);
                }

                let html = '';
                // Prev arrow
                html += `<li class="${prevDisabled ? 'page-item disabled' : 'page-item'}"><a class="page-link" data-page="${prevDisabled ? currentPage : currentPage-1}" href="#" aria-label="Previous">&laquo;</a></li>`;

                // Numeric buttons within window
                for (let i = startPage; i <= endPage; i++) {
                    html += `<li class="${i === currentPage ? 'page-item active' : 'page-item'}"><a class="page-link" data-page="${i}" href="#">${i}</a></li>`;
                }

                // Next arrow
                html += `<li class="${nextDisabled ? 'page-item disabled' : 'page-item'}"><a class="page-link" data-page="${nextDisabled ? currentPage : currentPage+1}" href="#" aria-label="Next">&raquo;</a></li>`;

                paginationList.innerHTML = html;
            }

            async function loadPage(page) {
                try {
                    const url = `${window.location.pathname}?handler=Page&page=${encodeURIComponent(page)}`;
                    console.log('loadPage url=', url);
                    const resp = await fetch(url, { 
                        credentials: 'same-origin',
                        headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' }
                    });
                    console.log('fetch response', resp.status, resp.headers.get('content-type'));
                    if (!resp.ok) throw new Error('Network error: ' + resp.status);
                    const data = await resp.json();
                    console.log('page data', data);

                    renderRows(data.items);
                    renderPagination({ currentPage: data.currentPage, totalPages: data.totalPages });
                    showingText.textContent = `Showing ${data.startItem}-${data.endItem} of ${data.totalItems} requests`;
                }
                catch (err) {
                    console.error(err);
                    // show user-visible hint in case of failure
                    tableBody.innerHTML = '<tr><td colspan="5" class="text-center text-danger">Failed to load page. See console for details.</td></tr>';
                }
            }

            // delegate click handler
            paginationList.addEventListener('click', function (e) {
                const a = e.target.closest ? e.target.closest('a.page-link') : null;
                console.log('pagination click', e.target, a);
                if (!a) return;
                e.preventDefault();
                const page = parseInt(a.getAttribute('data-page'), 10) || 1;
                console.log('loading page', page);
                loadPage(page);
            });
        })();
    </script>

}
