@page
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Leave Request List</title>

    <style src="~/apps/modules/leave/css/SupervisorDashboard.css"></style>
       
</head>
<body>

<div class="page-container">
    <div class="breadcrumb">
        Leave > <span>Request List</span>
    </div>

    <div class="header">
        <h1>Hello, <span id="userName">Supervisor</span></h1>
        <p>Here is an overview of your leave status and activity.</p>
    </div>

    <div class="tabs">
        <div class="tab active">Request List</div>
        <div class="tab" onclick="window.location.href='/Leave/Supervisor/Calendar'">Calendar</div>
    </div>

    <div class="card">

        <div class="toolbar">
            <div class="status-filters">
                <button class="status-btn active" onclick="filterStatus('pending')">Needs Approval</button>
                <button class="status-btn" onclick="filterStatus('approved')">Approved</button>
                <button class="status-btn" onclick="filterStatus('rejected')">Rejected</button>
            </div>

            <div class="search-sort">
                <div class="search-box">
                    <input type="text" id="searchInput" placeholder="Search Leave..." />
                </div>

                <select class="sort-select" id="sortSelect">
                    <option value="newest">Newest</option>
                    <option value="oldest">Oldest</option>
                </select>
            </div>
        </div>

        <div class="table-wrapper">
            <table>
                <thead>
                <tr>
                    <th>Employee Name</th>
                    <th>Leave Type</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Day(s)</th>
                    <th>Status</th>
                </tr>
                </thead>
                <tbody id="requestTableBody">
                </tbody>
            </table>
        </div>

        <div class="pagination">
            <span id="paginationText"></span>
            <div class="page-buttons" id="paginationButtons"></div>
        </div>

    </div>
</div>

<script src="~/apps/modules/leave/js/SupervisorDashboard.js"></script>

</body>
</html>