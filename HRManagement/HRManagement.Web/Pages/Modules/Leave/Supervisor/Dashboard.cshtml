@page "/leave/supervisor/dashboard"

@{
    ViewData["Title"] = "Leave Supervisor Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/apps/modules/leave/css/SupervisorDashboard.css" asp-append-version="true" />
    <style>
        #requestTableBody tr:hover {
            background-color: #dc3545 !important;
            color: #fff !important;
        }
        #requestTableBody tr:hover td {
            color: #fff !important;
        }
        #requestTableBody tr:hover .badge {
            color: #fff !important;
            opacity: 1 !important;
        }
        #requestTableBody td {
            padding: 1.1rem 2rem;
            vertical-align: middle;
        }
        #requestTableBody tr {
            box-sizing: border-box;
        }
        .leave-tab {
            display: inline-flex;
            align-items: center;
            padding-bottom: 12px;
            color: #7E8299;
            text-decoration: none;
            font-weight: 600;
            border-bottom: 2px solid transparent;
            transition: .2s;
        }

            .leave-tab.active {
                color: #E31837;
                border-color: #E31837;
            }

            .leave-tab:hover {
                color: #E31837;
            }

        .status-filter {
            border: 1px solid #E4E6EF;
            background: white;
            border-radius: 20px;
            padding: 6px 16px;
            font-size: 13px;
            transition: .2s;
        }

            .status-filter.active {
                background: #FFF5F8;
                border-color: #E31837;
                color: #E31837;
            }

            .status-filter:hover {
                border-color: #E31837;
            }

        .card {
            border-radius: 16px;
        }

        .table thead th {
            color: #181C32;
            font-size: 13px;
            font-weight: 700;
            border-bottom: 1px solid #EFF2F5;
        }

        #requestTableBody td {
            padding: 18px 20px;
        }

        #requestTableBody tr {
            transition: .18s;
        }

            #requestTableBody tr:hover {
                background: #E31837;
                color: white;
            }

                #requestTableBody tr:hover td,
                #requestTableBody tr:hover strong,
                #requestTableBody tr:hover small {
                    color: white !important;
                }

        .table-responsive {
            min-height: 550px;
        }

        #requestTableBody {
            min-height: 480px;
        }

        .empty-row td {
            height: 480px;
            vertical-align: middle !important;
        }

        .empty-state {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: #7E8299;
            height: 100%;
        }

        .status-filter {
            border: 1px solid #E4E6EF;
            background: #fff;
            color: #5E6278;
            border-radius: 20px;
            padding: 6px 18px;
            font-size: 13px;
            font-weight: 600;
            transition: .2s;
        }

            .status-filter:hover {
                border-color: #E31837;
                color: #E31837;
            }

            .status-filter.active {
                background: #E31837;
                color: #fff;
                border-color: #E31837;
            }

                .status-filter.active:hover {
                    background: #C8102E;
                    color: #fff;
                }
    </style>
}

<div class="mx-11">
    @await Html.PartialAsync("Layout/_PageHeader", new PageHeaderViewModel
    {
        Title = "Leave",
        Subtitle = "Overview of pending leave requests from your team",
        Breadcrumbs = new List<BreadcrumbItem> {
            new BreadcrumbItem { Title = "Leave", Url = "/Leave/Supervisor/Dashboard" },
            new BreadcrumbItem { Title = "Request List" }
        },
    })
</div>

<div class="container-fluid px-10">

    <!-- Greeting -->
    <div class="mb-8">
        <h2 class="fw-bold fs-1 mb-1">
            Hello, <span id="userName">Supervisor</span>
        </h2>

        <div class="text-gray-600 fs-6">
            Here is an overview of your leave status and activity.
        </div>
    </div>

    <!-- Tabs -->
    <div class="d-flex align-items-center gap-8 border-bottom mb-8">

        <a href="/Leave/Supervisor/Dashboard"
           class="leave-tab active">
            Request List
        </a>

        <a href="/Leave/Supervisor/Calendar"
           class="leave-tab">
            Calendar
        </a>

    </div>

    <!-- Card -->
    <div class="card shadow-sm border-0 rounded-4">

        <div class="card-body p-8">

            <!-- Toolbar -->
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-5 mb-8">

                <!-- Filter -->
                <button class="status-filter active"
                        onclick="filterStatus('1', this)">
                    Needs Approval
                </button>

                <button class="status-filter"
                        onclick="filterStatus('2', this)">
                    Approved
                </button>

                <button class="status-filter"
                        onclick="filterStatus('3', this)">
                    Rejected
                </button>

                <!-- Search -->
                <div class="position-relative">

                    <i class="ki-outline ki-magnifier fs-3 position-absolute top-50 start-0 translate-middle-y ms-4 text-gray-500"></i>

                    <input id="searchInput"
                           type="text"
                           class="form-control ps-12"
                           placeholder="Search Leave..."
                           style="width:320px;" />

                </div>

                <!-- Sort -->
                <div class="d-flex align-items-center gap-3">

                    <span class="text-gray-600">
                        Sort by:
                    </span>

                    <select id="sortSelect"
                            class="form-select form-select-sm"
                            style="width:120px;">
                        <option value="newest">
                            newest
                        </option>

                        <option value="oldest">
                            oldest
                        </option>
                    </select>

                </div>

            </div>

            <!-- Table -->
            <div class="table-responsive">

                <table class="table align-middle">

                    <thead>

                        <tr>

                            <th>Employee Name</th>
                            <th>Leave Type</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Day(s)</th>
                            <th class="text-center">
                                Status
                            </th>

                        </tr>

                    </thead>

                    <tbody id="requestTableBody">
                    </tbody>

                </table>

            </div>

            <!-- Footer -->

            <div class="d-flex justify-content-between align-items-center mt-7">

                <span id="showingText"
                      class="text-gray-600">
                    Showing 0-0 of 0 requests
                </span>

                <ul class="pagination mb-0"
                    id="paginationList">
                </ul>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <script src="~/apps/modules/leave/js/SupervisorDashboard.js" asp-append-version="true"></script>
}