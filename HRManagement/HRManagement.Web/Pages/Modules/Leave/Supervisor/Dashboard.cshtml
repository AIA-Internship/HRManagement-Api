@page "/leave/supervisor/dashboard"

@{
    ViewData["Title"] = "Leave Supervisor Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/apps/modules/leave/css/dashboard.css" asp-append-version="true" />
    <style>
        /* Card / container to match the mock */
        .card.mx-10.mb-15 {
            background: #FFFFFF;
            border: 1px solid #EFF2F5;
            border-radius: 12px;
            box-shadow: 0 1px 0 rgba(0,0,0,0.03);
        }

        .card.mx-10.mb-15 .card-body {
            padding: 0.5rem 0;
        }

        /* Employee avatar & info */
        .employee-avatar {
            width: 44px;
            height: 44px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            color: #ffffff;
            font-size: 14px;
            margin-right: 12px;
            flex-shrink: 0;
        }

        .employee-details {
            display: flex;
            flex-direction: column;
        }

        .employee-name {
            font-weight: 700;
            color: #181C32;
            margin: 0;
            font-size: 14px;
            line-height: 1.1;
        }

        .employee-role {
            font-size: 12px;
            color: #7E8299;
            margin: 0;
        }

        /* Leave type and date formatting */
        .leave-type {
            color: #4B5563;
            font-size: 13px;
            font-weight: 500;
        }

        .date-text {
            color: #6B7280;
            font-size: 13px;
        }

        .days-cell {
            font-weight: 700;
            color: #111827;
        }

        /* Use same table layout & alignment as Employee dashboard */
        /* On hover, only change row background and employee name color. Leave status badge colors unchanged. */
        #requestTableBody tr:hover {
            background-color: #dc3545 !important;
        }

        /* make employee name visible on hover */
        #requestTableBody tr:hover .employee-name {
            color: #fff !important;
        }
        #requestTableBody td {
            padding: 1.1rem 2rem;
            vertical-align: middle;
        }
        #requestTableBody tr {
            box-sizing: border-box;
        }

        /* Status badges - pill style to match image */
        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 12px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 600;
            min-width: 110px;
            justify-content: center;
        }

        /* Pending / Needs Approval */
        .status-needs-approval {
            color: #B54708 !important;
            background-color: #FFFAEB !important;
            border: 1px solid #FEDF89 !important;
        }

        /* Approved */
        .status-approved {
            color: #027A48 !important;
            background-color: #ECFDF3 !important;
            border: 1px solid #ABEFC6 !important;
        }

        /* Rejected */
        .status-rejected {
            color: #B42318 !important;
            background-color: #FEF3F2 !important;
            border: 1px solid #FECDCA !important;
        }

        /* Filter buttons (pill) */
        .btn-outline-secondary {
            border: 1px solid #E4E6EF;
            color: #5E6278;
            background: #fff;
            border-radius: 20px;
            padding: 6px 14px;
            font-size: 13px;
            font-weight: 600;
            transition: all 0.15s ease;
        }

        .btn-outline-secondary:hover {
            border-color: #E31837;
            color: #E31837;
            background: #fff;
        }

        .btn-outline-secondary.active {
            background: #E31837;
            color: white;
            border-color: #E31837;
        }

        /* center search and tidy toolbar layout */
        .toolbar-row { display:flex; align-items:center; gap:1rem; padding:0.75rem 1.25rem; }
        .toolbar-left { flex:0 0 auto; }
        .toolbar-center { flex:1 1 600px; display:flex; justify-content:center; }
        .toolbar-right { flex:0 0 auto; display:flex; align-items:center; gap:0.75rem; }

        .search-input { width:100%; border-radius:24px; padding:12px 18px 12px 42px; }
        .position-relative .bi-search { position:relative; left:14px; top:50%; transform:translateY(-50%); pointer-events:none; }

        /* keep default left alignment; status column is centered via class */
        .table tbody td:first-child { text-align:left; }

        /* make table header stand out with bolder line */
        .table thead th { border-bottom:2px solid #EFF2F5; background:#fff; }

        /* Table header styling: align header text to match column content
           - first column (employee) left-aligned
           - other columns center-aligned to match cell content */
        .table thead th {
            background-color: transparent;
            color: #181C32;
            font-size: 13px;
            font-weight: 700;
            padding: 1.1rem 2rem;
            text-align: center;
        }

        .table thead th:first-child { text-align: left; }

        /* Pagination - subtle rounded */
        .pagination .page-link {
            border-radius: 6px;
            padding: 0.4rem 0.6rem;
        }

        .pagination .page-item.active .page-link {
            background: #E31837;
            border-color: #E31837;
            color: #fff;
        }

        /* Empty state */
        .empty-row td { height: 480px; vertical-align: middle !important; }
        .empty-state { display:flex; flex-direction:column; justify-content:center; align-items:center; color:#7E8299; height:100%; }
        .empty-row:hover > td, .empty-row td:hover { background-color: transparent !important; }

    
        .stacked-toolbar .toolbar-row { padding:0.5rem; gap:0.5rem; flex-wrap:wrap; }
        .stacked-toolbar .toolbar-left,
        .stacked-toolbar .toolbar-right { flex: 0 0 100%; display:flex; justify-content:flex-start; }
        .stacked-toolbar .toolbar-center { order:2; flex: 1 1 100%; width:100%; }
        .stacked-toolbar .toolbar-right { justify-content:flex-end; }
        .stacked-toolbar .search-input { max-width:100%; }
        .stacked-toolbar .btn-group { gap:0.4rem; }

        .stacked-toolbar .toolbar-left,
        .stacked-toolbar .toolbar-right { padding-left:0.5rem; padding-right:0.5rem; }
        .stacked-toolbar .search-input { padding-left:42px; }
        .stacked-toolbar .table thead th,
        .stacked-toolbar .table tbody td { padding: 0.75rem 0.75rem; }
    </style>
}

<div class="container-fluid px-5">
    @await Html.PartialAsync("Layout/_PageHeader", new PageHeaderViewModel
    {
        Title = "Leave",
        Subtitle = "Overview of pending leave requests from your team",
        Breadcrumbs = new List<BreadcrumbItem> {
            new BreadcrumbItem { Title = "Leave", Url = "/Leave/Supervisor/Dashboard" },
            new BreadcrumbItem { Title = "Request List" }
        },
    })
</div>

<div class="container-fluid px-5">
    <div class="row mb-4 mx-3">
        <div class="col">
            <h2 class="fw-bold">Hello, <span id="userName">Supervisor</span></h2>
            <p class="text-muted">Here is an overview of your leave status and activity</p>
        </div>
    </div>

    <!-- Tabs: Request list / Calendar -->
    <div class="mb-4 px-5">
        <a href="#" id="tabRequest" class="leave-tab active me-4">Request list</a>
        <a href="#" id="tabCalendar" class="leave-tab">Calendar</a>
    </div>

<!-- Calendar Card (hidden by default) -->
<div class="card mx-10 mb-15" id="calendarCard" style="display:none;">
    <div class="card-body ps-0 pe-0">
        <div class="p-4">
            <div id="kt_calendar_app" style="min-height:540px;"></div>
        </div>
    </div>
</div>

    <div class="card mx-10 mb-15" id="requestCard">
        <div class="card-body ps-0 pe-0">
            <div class="toolbar-row">
                <div class="toolbar-left ms-7">
                    <div class="btn-group" role="group" aria-label="filters">
                        <button class="btn btn-outline-secondary" onclick="filterStatus('1', this)">Needs Approval</button>
                        <button class="btn btn-outline-secondary" onclick="filterStatus('2', this)">Approved</button>
                        <button class="btn btn-outline-secondary" onclick="filterStatus('3', this)">Rejected</button>
                    </div>
                </div>

                <div class="toolbar-center">
                    <div class="position-relative" style="width:100%; max-width:720px;">
                        <i class="bi bi-search position-absolute top-50 translate-middle-y text-muted" style="left:14px;"></i>
                        <input id="searchInput"
                               type="text"
                               class="form-control search-input ps-5"
                               placeholder="Search Leave..." />
                    </div>
                </div>

                <div class="toolbar-right me-4">
                    <label class="me-2">Sort by:</label>
                    <select id="sortSelect" class="form-select form-select-sm" style="width:120px;">
                        <option value="newest">newest</option>
                        <option value="oldest" selected>oldest</option>
                    </select>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th class="px-7"><strong>Employee Name</strong></th>
                            <th class="px-7"><strong>Leave Type</strong></th>
                            <th class="px-7"><strong>Start Date</strong></th>
                            <th class="px-7"><strong>End Date</strong></th>
                            <th class="px-7"><strong>Day(s)</strong></th>
                            <th class="px-7 text-center"><strong>Status</strong></th>
                        </tr>
                    </thead>
                    <tbody id="requestTableBody">
                    </tbody>
                </table>
            </div>

            <div class="d-flex align-items-center justify-content-between mt-3 ms-7 me-7">
                <div class="text-muted" id="showingText">Showing 0-0 of 0 requests</div>
                <nav aria-label="pagination">
                    <ul class="pagination mb-0" id="paginationList">
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/apps/modules/leave/js/SupervisorDashboard.js" asp-append-version="true"></script>
    <script src="/assets/plugins/custom/fullcalendar/fullcalendar.bundle.js" asp-append-version="true"></script>
    <script src="/assets/js/custom/apps/calendar/calendar.js" asp-append-version="true"></script>
}