@page "/Timesheet/Employee/Report"
@using HRManagement.Web.Pages.Modules.Timesheet
@using HRManagement.Web.Models.Shared
@model HRManagement.Web.Pages.Modules.Timesheet.ReportModel
@{
    ViewData["Title"] = "Timesheet Report";
}

@section Styles {
    <link rel="stylesheet" href="~/apps/shared/forms/common-input-dropdowns.css" asp-append-version="true" />
    <style>
        :root { --brand-red: #D31145; --border-subtle: #E1E3EA; }
        body { background-color: #F8F9FA !important; font-family: 'Inter', 'Outfit', sans-serif; }

        .report-card {
            background: #fff;
            border-radius: 12px;
            border: 1px solid var(--border-subtle);
            box-shadow: 0 4px 16px rgba(0,0,0,0.03);
            overflow: hidden;
            margin-bottom: 40px;
        }

        .report-table { width: 100%; border-collapse: collapse; }
        .report-table thead tr { background: #F8F9FA; border-bottom: 2px solid #E1E3EA; border-top: 1px solid #E1E3EA; }
        .report-table th {
            padding: 14px 20px;
            font-size: 0.7rem;
            font-weight: 900;
            color: #7E8299;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            text-align: center;
        }
        .report-table th:first-child { text-align: left; }
        
        .report-table td {
            padding: 18px 20px;
            font-size: 0.85rem;
            font-weight: 600;
            color: #3F4254;
            border-bottom: 1px solid #F4F6FA;
            vertical-align: middle;
            text-align: center;
        }
        .report-table td:first-child { text-align: left; }
        .report-table tr:last-child td { border-bottom: none; }
        
        .report-table tbody tr {
            transition: background 0.2s;
            cursor: pointer;
        }
        .report-table tbody tr:hover {
            background: #F9FAFB;
        }

        .status-badge {
            padding: 6px 16px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 700;
            display: inline-block;
            min-width: 120px;
        }
        .status-needs-approval { background: #FFF4CC; color: #E4A900; }
        .status-approved { background: #DCF5E3; color: #2EAA55; }
        .status-revision { background: #FDE8EE; color: var(--brand-red); }
        .status-draft { background: #F1F1F4; color: #7E8299; }

        .btn-export-icon {
            color: #181C32;
            background: transparent;
            border: none;
            font-size: 1.2rem;
            padding: 4px 8px;
            border-radius: 4px;
            transition: all 0.2s;
        }
        .btn-export-icon:hover {
            background: #F1F1F4;
            color: var(--brand-red);
        }
    </style>
}

<div class="d-flex flex-column flex-column-fluid mt-4 app-container-full">
    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div id="kt_app_content_container" class="app-container container-fluid">

            @await Html.PartialAsync("Layout/_PageHeader", new PageHeaderViewModel {
                Title = "Report",
                Subtitle = "Review Your Timesheet Status, History, And Export",
                Breadcrumbs = new List<BreadcrumbItem> {
                    new BreadcrumbItem { Title = "Timesheet", Url = "/Timesheet/Employee/Dashboard" },
                    new BreadcrumbItem { Title = "Report" }
                }
            })

            <div class="report-card mt-8">
                <div class="d-flex justify-content-between align-items-center p-6 border-bottom" style="border-color: var(--border-subtle) !important;">
                    <div class="d-flex align-items-center gap-3">
                        <i class="bi bi-inbox-fill text-dark fs-2"></i>
                        <h3 class="mb-0 fw-bolder text-dark" style="font-size: 1.15rem;">Timesheet History</h3>
                    </div>
                    <div class="d-flex gap-3">
                        <div class="aia-custom-select-wrap" style="width: 140px;">
                            <div class="aia-select-trigger" onclick="toggleAiaSelect(this, event)">
                                <span class="trigger-text">All months</span>
                                <i class="bi bi-chevron-down"></i>
                            </div>
                            <div class="aia-select-popover">
                                <div class="aia-select-option selected" data-id="" data-value="All months" onclick="selectAiaOption(this); handleFilterChange();">All months</div>
                                <div class="aia-select-option" data-id="1" data-value="January" onclick="selectAiaOption(this); handleFilterChange();">January</div>
                                <div class="aia-select-option" data-id="2" data-value="February" onclick="selectAiaOption(this); handleFilterChange();">February</div>
                                <div class="aia-select-option" data-id="3" data-value="March" onclick="selectAiaOption(this); handleFilterChange();">March</div>
                                <div class="aia-select-option" data-id="4" data-value="April" onclick="selectAiaOption(this); handleFilterChange();">April</div>
                                <div class="aia-select-option" data-id="5" data-value="May" onclick="selectAiaOption(this); handleFilterChange();">May</div>
                                <div class="aia-select-option" data-id="6" data-value="June" onclick="selectAiaOption(this); handleFilterChange();">June</div>
                                <div class="aia-select-option" data-id="7" data-value="July" onclick="selectAiaOption(this); handleFilterChange();">July</div>
                                <div class="aia-select-option" data-id="8" data-value="August" onclick="selectAiaOption(this); handleFilterChange();">August</div>
                                <div class="aia-select-option" data-id="9" data-value="September" onclick="selectAiaOption(this); handleFilterChange();">September</div>
                                <div class="aia-select-option" data-id="10" data-value="October" onclick="selectAiaOption(this); handleFilterChange();">October</div>
                                <div class="aia-select-option" data-id="11" data-value="November" onclick="selectAiaOption(this); handleFilterChange();">November</div>
                                <div class="aia-select-option" data-id="12" data-value="December" onclick="selectAiaOption(this); handleFilterChange();">December</div>
                            </div>
                            <input type="hidden" class="aia-select-value" value="">
                            <input type="hidden" class="aia-select-id" id="filter_month" value="">
                        </div>

                        <div class="aia-custom-select-wrap" style="width: 140px;">
                            <div class="aia-select-trigger" onclick="toggleAiaSelect(this, event)">
                                <span class="trigger-text">All years</span>
                                <i class="bi bi-chevron-down"></i>
                            </div>
                            <div class="aia-select-popover">
                                <div class="aia-select-option selected" data-id="" data-value="All years" onclick="selectAiaOption(this); handleFilterChange();">All years</div>
                                <div class="aia-select-option" data-id="2026" data-value="2026" onclick="selectAiaOption(this); handleFilterChange();">2026</div>
                                <div class="aia-select-option" data-id="2025" data-value="2025" onclick="selectAiaOption(this); handleFilterChange();">2025</div>
                            </div>
                            <input type="hidden" class="aia-select-value" value="">
                            <input type="hidden" class="aia-select-id" id="filter_year" value="">
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="report-table">
                        <thead>
                            <tr>
                                <th style="padding-left: 30px; width: 40%;">MONTH/PERIOD <i class="bi bi-arrow-down ms-1"></i></th>
                                <th style="width: 30%;">APPROVAL STATUS</th>
                                <th style="width: 30%;">EXPORT</th>
                            </tr>
                        </thead>
                        <tbody id="history_tbody">
                            <tr>
                                <td colspan="3" class="text-center py-10 text-muted fw-bold">Loading history...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.sheetjs.com/xlsx-0.20.1/package/dist/xlsx.full.min.js"></script>
    <script src="~/apps/modules/timesheet/js/timesheet-management.js" asp-append-version="true"></script>
    <script src="~/apps/modules/timesheet/js/timesheet-export.js" asp-append-version="true"></script>
    <script>
        const MONTHS = ["January","February","March","April","May","June","July","August","September","October","November","December"];

        let allHistoryData = [];

        async function initHistory() {
            const token = localStorage.getItem('aia_jwt_token');
            if (!token) {
                window.location.href = '/Account/Login';
                return;
            }

            try {
                const res = await fetch(`https://localhost:7089/api/timesheet/submission/history`, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });

                if (res.status === 401) {
                    localStorage.removeItem('aia_jwt_token');
                    window.location.href = '/Account/Login';
                    return;
                }

                const json = await res.json();
                if (json.isError) {
                    document.getElementById('history_tbody').innerHTML = `<tr><td colspan="3" class="text-center text-danger fw-bold py-10">${json.message}</td></tr>`;
                    return;
                }

                allHistoryData = json.content || [];
                renderHistory(allHistoryData);

            } catch (e) {
                console.error(e);
                document.getElementById('history_tbody').innerHTML = `<tr><td colspan="3" class="text-center text-danger fw-bold py-10">Failed to load history data.</td></tr>`;
            }
        }

        function handleFilterChange() {
            const monthVal = document.getElementById('filter_month').value;
            const yearVal = document.getElementById('filter_year').value;
            
            let filtered = allHistoryData;
            
            if (monthVal) {
                filtered = filtered.filter(x => x.month == monthVal);
            }
            if (yearVal) {
                filtered = filtered.filter(x => x.year == yearVal);
            }
            
            renderHistory(filtered);
        }

        function renderHistory(data) {
            const tbody = document.getElementById('history_tbody');
            tbody.innerHTML = '';

            if (!data || data.length === 0) {
                tbody.innerHTML = `<tr><td colspan="3" class="text-center py-10 fw-bold text-muted">No timesheet history found.</td></tr>`;
                return;
            }

            // Sort data by year descending, month descending
            data.sort((a, b) => {
                if (b.year !== a.year) return b.year - a.year;
                return b.month - a.month;
            });

            data.forEach(item => {
                const tr = document.createElement('tr');
                tr.onclick = (e) => {
                    // Prevent redirect if clicking on the export button
                    if(e.target.closest('button')) return;
                    window.location.href = `/Timesheet/Employee/ReportDetail?year=${item.year}&month=${item.month}`;
                };

                let statusBadge = '';
                let exportBtn = '';

                if (item.status === 'Approved') {
                    statusBadge = '<span class="status-badge status-approved">Approved</span>';
                    exportBtn = `<button class="btn-export-icon" onclick="exportTimesheet(${item.year}, ${item.month})"><i class="bi bi-download"></i></button>`;
                } else if (item.status === 'Waiting for Approval' || item.status === 'Waiting' || item.status === 'Pending') {
                    statusBadge = '<span class="status-badge status-needs-approval">Needs Approval</span>';
                    exportBtn = `<button class="btn-export-icon" style="color: #D0D3DC; cursor: not-allowed;" disabled><i class="bi bi-download"></i></button>`;
                } else if (item.status === 'Need Revision' || item.status === 'Revision') {
                    statusBadge = '<span class="status-badge status-revision">Need Revision</span>';
                    exportBtn = `<button class="btn-export-icon" style="color: #D0D3DC; cursor: not-allowed;" disabled><i class="bi bi-download"></i></button>`;
                } else {
                    statusBadge = `<span class="status-badge status-draft">${item.status || 'Draft'}</span>`;
                    exportBtn = `<button class="btn-export-icon" style="color: #D0D3DC; cursor: not-allowed;" disabled><i class="bi bi-download"></i></button>`;
                }

                tr.innerHTML = `
                    <td style="padding-left: 30px;">${MONTHS[item.month - 1]} ${item.year}</td>
                    <td>${statusBadge}</td>
                    <td>${exportBtn}</td>
                `;
                tbody.appendChild(tr);
            });
        }

        // exportTimesheet(year, month) is defined in timesheet-export.js

        document.addEventListener('DOMContentLoaded', initHistory);
    </script>
}
