@page "/Timesheet/Employee/Management"
@model HRManagement.Web.Pages.Modules.Timesheet.ManagementModel
@{
    ViewData["Title"] = "Timesheet Logbook";
}

@section Styles {
    <link rel="stylesheet" href="~/apps/modules/timesheet/css/timesheet-management.css" asp-append-version="true" />
}

<div class="d-flex flex-column flex-column-fluid app-container-full bg-white">
    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div id="kt_app_content_container" class="app-container container-fluid">
            
            @await Html.PartialAsync("Layout/_PageHeader", new PageHeaderViewModel {
                Title = "Timesheet Daily Log",
                Subtitle = "Monitor and manage your monthly work logs with ease",
                Breadcrumbs = new List<BreadcrumbItem> {
                    new BreadcrumbItem { Title = "Timesheet", Url = "/Timesheet/Employee/Dashboard" },
                    new BreadcrumbItem { Title = "Daily Log" }
                },
                RenderActions = Html.Raw("<div id=\"header_status_badge\" class=\"d-none\"></div>")
            })


            <!-- PERFECT BASELINE CONTAINER (v8.1) -->
            <div class="px-0 py-5">
                
                <!-- UNIFIED TOOLBAR NAV (1-Line Layout Match with Supervisor) -->
                <!-- UNIFIED TOOLBAR NAV (SLIDER FORMAT) -->
                <div class="d-flex flex-wrap align-items-center bg-white shadow-sm p-4 mb-8" style="border-radius: 14px; border: 1px solid #F1F4F9;">
                    
                    <!-- View Segment Control -->
                    <div style="flex: 1; display: flex; justify-content: flex-start;">
                        <div class="timesheet-tabs-nav bg-light p-1" style="border-radius: 8px; display: flex; gap: 4px;">
                            <button class="nav-link active btn-sm" onclick="switchView('monthly', this)" style="border-radius: 6px; padding: 6px 16px;">Monthly</button>
                            <button class="nav-link btn-sm" onclick="switchView('weekly', this)" style="border-radius: 6px; padding: 6px 16px;">Weekly</button>
                            <button class="nav-link btn-sm" onclick="switchView('daily', this)" style="border-radius: 6px; padding: 6px 16px;">Daily</button>
                        </div>
                    </div>

                    <!-- Date Scroller (Keep Intern Font) -->
                    <div class="date-selector-container position-relative d-flex align-items-center gap-4">
                        <button class="btn-nav-arrow rounded-circle shadow-sm" onclick="moveDate(-1, 'left')" style="width: 44px; height: 44px; display: flex; align-items:center; justify-content: center; background: #fff;"><i class="bi bi-chevron-left fs-4"></i></button>
                        
                        <div class="d-flex flex-column align-items-center">
                            <h1 class="current-date-title d-flex align-items-center gap-3 px-6 py-3 mb-0" style="cursor:pointer; background: #F8F9FA; border-radius: 14px;" onclick="toggleDatePopup(event)">
                                <i class="bi bi-calendar3 text-brand fs-3"></i>
                                <span id="current_view_label">...</span>
                            </h1>
                            @* GLOBAL POPOVERS NOW LOADED IN _LAYOUT *@
                        </div>

                        <button class="btn-nav-arrow rounded-circle shadow-sm" onclick="moveDate(1, 'right')" style="width: 44px; height: 44px; display: flex; align-items:center; justify-content: center; background: #fff;"><i class="bi bi-chevron-right fs-4"></i></button>
                    </div>

                    <!-- Actions -->
                    <div style="flex: 1; display: flex; justify-content: flex-end;">
                        <div class="btn-group-actions d-flex align-items-center gap-3">
                            <button class="btn-today-white shadow-sm" style="border-radius: 8px; font-weight: 700; padding: 10px 16px;" onclick="currentDate = new Date(); renderCurrentState();">Today</button>
                            <button class="shadow-sm" id="btn_view_timesheet" style="border-radius: 8px; font-weight: 700; padding: 10px 16px; background: white; color: var(--brand-red); border: 1px solid var(--brand-red); transition: all 0.2s;" onclick="window.location.href='/Timesheet/Employee/Report'">View Timesheet</button>
                            <button class="shadow-sm d-none" id="btn_edit_timesheet" style="border-radius: 8px; font-weight: 700; padding: 10px 16px; background: var(--brand-red); color: white; border: 1px solid var(--brand-red); transition: all 0.2s;" onclick="window.location.href='/Timesheet/Employee/Entry'"><i class="bi bi-pencil-square me-2 text-white"></i> Edit Timesheet</button>
                        </div>
                    </div>
                </div>


                <!-- MAIN RESULTS PORT -->
                <div class="mt-8 pb-10">
                    <div id="view_monthly" class="timesheet-view">
                        <div class="monthly-calendar-grid shadow-sm">
                            <div class="grid-header">
                                <div class="grid-header-cell">MON</div><div class="grid-header-cell">TUE</div><div class="grid-header-cell">WED</div>
                                <div class="grid-header-cell">THU</div><div class="grid-header-cell">FRI</div>
                                <div class="grid-header-cell text-danger">SAT</div><div class="grid-header-cell text-danger">SUN</div>
                            </div>
                            <!-- DYNAMICALLY POPULATED BY JS -->
                            <div id="monthly_grid_container" style="display: flex; flex-wrap: wrap;"></div>
                        </div>
                    </div>

                    <div id="view_weekly" class="timesheet-view d-none">
                        <div class="card shadow-sm border-0" style="border-radius: 12px; overflow: hidden;">
                            <table class="weekly-master-table">
                                <thead class="bg-light text-uppercase fs-8 fw-bold text-gray-600" style="letter-spacing: 0.5px;">
                                    <tr>
                                        <th style="width: 10%" class="text-center py-5">STATUS</th>
                                        <th style="width: 10%" class="py-5">DAY</th>
                                        <th style="width: 10%" class="py-5">DATE</th>
                                        <th style="width: 10%" class="text-center py-5">DURATION</th>
                                        <th style="width: 15%" class="py-5">PROJECT</th>
                                        <th style="width: 10%" class="py-5">APPS USED</th>
                                        <th style="width: 15%" class="py-5">TASK DESCRIPTION</th>
                                        <th style="width: 10%" class="py-5">LOCATION</th>
                                        <th style="width: 10%" class="text-center py-5">REMARK</th>
                                    </tr>
                                </thead>
                                <tbody id="weekly_log_tbody">
                                    <!-- Populated dynamically by JS -->
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div id="view_daily" class="timesheet-view d-none">
                        <div class="card shadow-sm border-0" style="border-radius: 12px; overflow: hidden;">
                            <table class="daily-master-table w-100">
                                <thead>
                                    <tr>
                                        <th style="width: 15%">Duration</th>
                                        <th style="width: 20%">Project</th>
                                        <th style="width: 15%">Apps Used</th>
                                        <th>Task Description</th>
                                        <th style="width: 15%">Project Lead</th>
                                        <th style="width: 15%">Location</th>
                                    </tr>
                                </thead>
                                <tbody id="view_daily_tbody">
                                    <tr class="align-middle">
                                        <td colspan="6" class="text-center p-20">
                                            <div class="spinner-border text-danger" role="status"></div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div> <!-- END PERFECT BASELINE WRAPPER -->
        </div>
    </div>
</div>

<!-- FLOATING ACTION BUTTON (FAB) -->
<a href="javascript:void(0)" onclick="window.location.href='/Timesheet/Employee/Entry?date=' + (new Date().toISOString().split('T')[0])" 
   class="btn btn-icon btn-danger shadow-lg rounded-circle" 
   style="position: fixed; bottom: 40px; right: 40px; width: 65px; height: 65px; z-index: 1000; transition: all 0.2s; box-shadow: 0 10px 20px rgba(211,17,69,0.3) !important; background-color: #B21B38 !important; border: none;"
   onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">
    <i class="bi bi-plus" style="font-size: 2.5rem; color: white;"></i>
</a>

<!-- DATE PICKER MODALS (ANCHORED NEAR DATE) -->
<div class="modal fade modal-anchored-date" id="modal_monthly_picker" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="datepicker-header">
                <button class="btn btn-icon btn-sm btn-light h-30px w-30px rounded-circle"><i class="bi bi-chevron-left"></i></button>
                <div class="title" id="m_picker_year">...</div>
                <button class="btn btn-icon btn-sm btn-light h-30px w-30px rounded-circle"><i class="bi bi-chevron-right"></i></button>
            </div>
            <div class="datepicker-grid-3">
                @foreach (var m in new[] {"Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"}) {
                    <div class="datepicker-month-cell @(m == "Mar" ? "selected" : "")">@m</div>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade modal-anchored-date" id="modal_weekly_picker" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="datepicker-header">
                <button class="btn btn-icon btn-sm btn-light h-30px w-30px rounded-circle"><i class="bi bi-chevron-left"></i></button>
                <div class="title" id="w_picker_month">...</div>
                <button class="btn btn-icon btn-sm btn-light h-30px w-30px rounded-circle"><i class="bi bi-chevron-right"></i></button>
            </div>
            <div class="datepicker-grid-7 px-4">
                @foreach (var d in new[] {"MO", "TU", "WE", "TH", "FR", "SA", "SU"}) { <div class="datepicker-day-head">@d</div> }
                @for (int i=1; i<=31; i++) {
                    <div class="datepicker-day-cell @(i >= 2 && i <= 8 ? "selected" : "")">@i</div>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade modal-anchored-date" id="modal_daily_picker" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="datepicker-header">
                <button class="btn btn-icon btn-sm btn-light h-30px w-30px rounded-circle"><i class="bi bi-chevron-left"></i></button>
                <div class="title" id="d_picker_month">...</div>
                <button class="btn btn-icon btn-sm btn-light h-30px w-30px rounded-circle"><i class="bi bi-chevron-right"></i></button>
            </div>
            <div class="datepicker-grid-7 px-4">
                @foreach (var d in new[] {"MO", "TU", "WE", "TH", "FR", "SA", "SU"}) { <div class="datepicker-day-head">@d</div> }
                @for (int i=1; i<=31; i++) {
                    <div class="datepicker-day-cell @(i == 5 ? "selected" : "")">@i</div>
                }
            </div>
        </div>
    </div>
</div>



@section Scripts {
    <script src="~/apps/modules/timesheet/js/timesheet-management.js" asp-append-version="true"></script>
}
