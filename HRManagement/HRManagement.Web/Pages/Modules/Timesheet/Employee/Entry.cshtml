@page "/Timesheet/Employee/Entry"
@model HRManagement.Web.Pages.Modules.Timesheet.EntryModel
@{
    ViewData["Title"] = "Daily Entry";
}

@section Styles {
    <link rel="stylesheet" href="~/apps/modules/timesheet/css/timesheet-management.css" asp-append-version="true" />
}

<div class="d-flex flex-column flex-column-fluid app-container-full bg-white">
    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div id="kt_app_content_container" class="app-container container-fluid">
            
            @await Html.PartialAsync("Layout/_PageHeader", new PageHeaderViewModel {
                Title = "Timesheet Daily Log",
                Subtitle = "Work activities for <span id='entry_date_label' class='fw-boldest text-brand'>...</span>",
                Breadcrumbs = new List<BreadcrumbItem> {
                    new BreadcrumbItem { Title = "Timesheet", Url = "/Timesheet/Employee/Dashboard" },
                    new BreadcrumbItem { Title = "Daily Log" }
                },
                RenderActions = Html.Raw(@"
                    <div class='day-type-group header-integrated shadow-sm'>
                        <input type='radio' name='day_type' id='day_working' value='working' checked onchange='toggleDayType(this)'>
                        <label for='day_working' class='day-type-btn'>
                            <i class='bi bi-briefcase-fill'></i>
                            <span>Working</span>
                        </label>

                        <input type='radio' name='day_type' id='day_holiday' value='holiday' onchange='toggleDayType(this)'>
                        <label for='day_holiday' class='day-type-btn holiday'>
                            <i class='bi bi-balloon-heart-fill'></i>
                            <span>Holiday</span>
                        </label>

                        <input type='radio' name='day_type' id='day_off' value='off' onchange='toggleDayType(this)'>
                        <label for='day_off' class='day-type-btn off'>
                            <i class='bi bi-slash-circle-fill'></i>
                            <span>Off</span>
                        </label>
                    </div>
                ")
            })

            <!-- THE MAIN LOG ENTRY TABLE -->

            <div class="entry-table-wrap mb-10">
                <table class="daily-master-table w-100 mb-0">
                    <thead>
                        <tr>
                            <th style="width: 110px" class="text-center">DURATION</th>
                            <th style="width: 180px">PROJECT</th>
                            <th style="width: 120px">APPS USED</th>
                            <th>TASK DESCRIPTION</th>
                            <th style="width: 150px">PROJECT LEAD</th>
                            <th style="width: 140px">LOCATION</th>
                            <th style="width: 60px" class="text-center">ACTION</th>
                        </tr>
                    </thead>
                    <tbody id="log_entry_tbody">
                        <tr class="align-middle">
                            <td class="p-4 position-relative">
                                <div class="d-flex align-items-center justify-content-center gap-2">
                                    <input type="text" class="entry-input text-center duration-trigger" value="00h 00m" style="width:100px; cursor:pointer" readonly onclick="toggleDurationPicker(this, event)">
                                </div>
                                <!-- DURATION SPINNER POPOVER -->
                                <div class="duration-picker-popover shadow-lg">
                                    <div class="duration-columns">
                                        <div class="duration-col">
                                            <span class="duration-col-label">HH</span>
                                            <div class="duration-items-scroll">
                                                @for (int h=0; h<24; h++) { <div class="duration-item @(h==0?"selected":"")" onclick="selectHH(this, @h)">@h.ToString("D2")</div> }
                                            </div>
                                        </div>
                                        <div class="duration-col">
                                            <span class="duration-col-label">MM</span>
                                            <div class="duration-items-scroll">
                                                @for (int m=0; m<60; m+=5) { <div class="duration-item @(m==0?"selected":"")" onclick="selectMM(this, @m)">@m.ToString("D2")</div> }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td class="p-4">
                                <div class="aia-custom-select-wrap">
                                    <div class="aia-select-trigger" onclick="toggleAiaSelect(this, event)">
                                        <span class="trigger-text">Select Project</span>
                                        <i class="bi bi-chevron-down"></i>
                                    </div>
                                    <div class="aia-select-popover">
                                        <div class="aia-select-option" data-id="1" data-value="Insurable Interest" data-lead="Novia" data-lead-id="1" onclick="selectAiaOption(this)">Insurable Interest</div>
                                        <div class="aia-select-option" data-id="2" data-value="Click Revamp" data-lead="Hansen" data-lead-id="1" onclick="selectAiaOption(this)">Click Revamp</div>
                                        <div class="aia-select-option" data-id="3" data-value="iRecruit" data-lead="Hansen" data-lead-id="1" onclick="selectAiaOption(this)">iRecruit 3.0</div>
                                    </div>
                                    <input type="hidden" class="aia-select-value" value="">
                                    <input type="hidden" class="aia-select-id" value="">
                                    <input type="hidden" class="aia-select-lead-id" value="">
                                </div>
                            </td>
                            <td class="p-4"><input type="text" class="entry-input" placeholder="App Used"></td>
                            <td class="p-4"><textarea class="entry-input" style="height:48px; min-height:48px" placeholder="Describe what you do...."></textarea></td>
                            <td class="p-4"><input type="text" class="entry-input bg-light-gray" placeholder="Project Lead" readonly></td>
                            <td class="p-4">
                                <div class="aia-custom-select-wrap">
                                    <div class="aia-select-trigger" onclick="toggleAiaSelect(this, event)">
                                        <span class="trigger-text">Location</span>
                                        <i class="bi bi-chevron-down"></i>
                                    </div>
                                    <div class="aia-select-popover">
                                        <div class="aia-select-option" data-id="0" data-value="AIA Central" onclick="selectAiaOption(this)">AIA Central (Office)</div>
                                        <div class="aia-select-option" data-id="1" data-value="WFH" onclick="selectAiaOption(this)">WFH</div>
                                    </div>
                                    <input type="hidden" class="aia-select-value" value="">
                                    <input type="hidden" class="aia-select-id" value="">
                                </div>
                            </td>
                            <td class="p-4 text-center">
                                <button class="btn btn-icon btn-light-danger btn-sm rounded-circle h-35px w-35px" onclick="this.closest('tr').remove();">
                                    <i class="bi bi-trash-fill"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="7" class="p-0" style="border-bottom: 0;">
                                <div class="p-6 border-top">
                                    <button class="btn-add-row" onclick="addNewLogEntry()">
                                        <i class="bi bi-plus-circle-fill"></i> Add Entry
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <!-- STICKY SAVE FOOTER (EXACT MATCH) -->
            <div class="save-footer-sticky">
                <div class="container-fluid d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center">
                        <div class="symbol symbol-45px symbol-circle me-4">
                            <span class="symbol-label bg-light-danger">
                                <i class="bi bi-clock-history text-danger fs-3"></i>
                            </span>
                        </div>
                        <div class="d-flex flex-column">
                            <span class="text-muted fw-boldest fs-8 text-uppercase">Total Logged Hours Today</span>
                            <span id="total_log_hours" class="text-dark fw-950 fs-4">00h 00m</span>
                        </div>
                    </div>
                    <div class="d-flex gap-4">
                        <button class="btn-standard-ghost" onclick="window.location.href='/Timesheet/Employee/Dashboard'">
                            Discard
                        </button>
                        <button class="btn-standard-primary" onclick="saveDailyTimesheet()">
                            <i class="bi bi-box-arrow-in-down"></i> Save Timesheet
                        </button>
                    </div>
                </div>
            </div>


        </div>
    </div>
</div>


@section Scripts {
    <script src="~/apps/modules/timesheet/js/timesheet-management.js" asp-append-version="true"></script>
}
