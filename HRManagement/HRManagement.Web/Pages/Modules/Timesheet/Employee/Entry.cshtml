@page "/Timesheet/Employee/Entry"
@model HRManagement.Web.Pages.Modules.Timesheet.EntryModel
@{
    ViewData["Title"] = "Daily Entry";
}

@section Styles {
    <link rel="stylesheet" href="~/apps/shared/badges/status-badges.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/apps/modules/timesheet/css/timesheet-management.css" asp-append-version="true" />
}

<div class="d-flex flex-column flex-column-fluid app-container-full bg-white">
    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div id="kt_app_content_container" class="app-container container-fluid">
            
            @await Html.PartialAsync("Layout/_PageHeader", new PageHeaderViewModel {
                Title = "Timesheet Daily Log",
                Subtitle = "Work activities for <span id='entry_date_label' class='fw-boldest text-brand'>...</span>",
                Breadcrumbs = new List<BreadcrumbItem> {
                    new BreadcrumbItem { Title = "Timesheet", Url = "/Timesheet/Employee/Dashboard" },
                    new BreadcrumbItem { Title = "Daily Log" }
                },
                RenderActions = Html.Raw(@"
                    <div class='d-flex align-items-center gap-3'>
                        <span class='text-muted fw-bold fs-8 text-uppercase' style='letter-spacing:0.5px;'>Day Type</span>
                        <div class='d-flex align-items-center p-1 bg-white shadow-sm' style='border-radius:12px; border:1.5px solid #E1E3EA;'>
                            <div id='pill_working' class='day-type-pill active' onclick='window.selectDayTypeToggle(""working"")' data-value='working' style='user-select:none; cursor:pointer; padding:8px 16px; border-radius:10px; font-weight:800; font-size:0.95rem; color:#181C32; background-color:#F1F4F9; transition:0.2s;'>
                                <i class='bi bi-briefcase-fill me-2'></i>Workday
                            </div>
                            <div id='pill_off' class='day-type-pill' onclick='window.selectDayTypeToggle(""off"")' data-value='off' style='user-select:none; cursor:pointer; padding:8px 20px; border-radius:10px; font-weight:800; font-size:0.95rem; color:#A1A5B7; background-color:transparent; transition:0.2s;'>
                                <i class='bi bi-calendar-x-fill me-2'></i>Off
                            </div>
                            <input type='hidden' id='day_type_select' value='working'>
                        </div>
                    </div>
                ")
            })

            <!-- THE MAIN LOG ENTRY TABLE -->
            <div id="entry_supervisor_remark_container" class="mb-4" style="display:none;"></div>

            <div class="entry-table-wrap mb-10">
                <table class="daily-master-table w-100 mb-0">
                    <thead>
                        <tr>
                            <th style="width: 110px" class="text-center">DURATION</th>
                            <th style="width: 180px">PROJECT</th>
                            <th style="width: 120px">APPS USED</th>
                            <th>TASK DESCRIPTION</th>
                            <th style="width: 150px">PROJECT LEAD</th>
                            <th style="width: 140px">LOCATION</th>
                            <th style="width: 60px" class="text-center">ACTION</th>
                        </tr>
                    </thead>
                    <tbody id="log_entry_tbody">
                        <tr class="align-middle">
                            <td class="p-4 position-relative">
                                <div class="d-flex align-items-center justify-content-center gap-2">
                                    <input type="text" class="entry-input text-center duration-trigger" value="00h 00m" style="width:100px; cursor:pointer" readonly onclick="toggleDurationPicker(this, event)">
                                </div>
                                <!-- DURATION SPINNER POPOVER -->
                                <div class="duration-picker-popover shadow-lg">
                                    <div class="duration-columns">
                                        <div class="duration-col">
                                            <span class="duration-col-label">HH</span>
                                            <div class="duration-items-scroll">
                                                @for (int h=0; h<24; h++) { <div class="duration-item @(h==0?"selected":"")" onclick="selectHH(this, @h)">@h.ToString("D2")</div> }
                                            </div>
                                        </div>
                                        <div class="duration-col">
                                            <span class="duration-col-label">MM</span>
                                            <div class="duration-items-scroll">
                                                @for (int m=0; m<60; m+=5) { <div class="duration-item @(m==0?"selected":"")" onclick="selectMM(this, @m)">@m.ToString("D2")</div> }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td class="p-4">
                                <div class="aia-custom-select-wrap">
                                    <div class="aia-select-trigger" onclick="toggleAiaSelect(this, event)">
                                        <span class="trigger-text">Select Project</span>
                                        <i class="bi bi-chevron-down"></i>
                                    </div>
                                    <div class="aia-select-popover">
                                        <div class="aia-select-option" data-id="1" data-value="Insurable Interest" data-lead="Novia" data-lead-id="1" onclick="selectAiaOption(this)">Insurable Interest</div>
                                        <div class="aia-select-option" data-id="2" data-value="Click Revamp" data-lead="Hansen" data-lead-id="1" onclick="selectAiaOption(this)">Click Revamp</div>
                                        <div class="aia-select-option" data-id="3" data-value="iRecruit" data-lead="Hansen" data-lead-id="1" onclick="selectAiaOption(this)">iRecruit 3.0</div>
                                    </div>
                                    <input type="hidden" class="aia-select-value" value="">
                                    <input type="hidden" class="aia-select-id" value="">
                                    <input type="hidden" class="aia-select-lead-id" value="">
                                </div>
                            </td>
                            <td class="p-4"><input type="text" class="entry-input" placeholder="App Used"></td>
                            <td class="p-4"><textarea class="entry-input" style="height:48px; min-height:48px" placeholder="Describe what you do...."></textarea></td>
                            <td class="p-4"><input type="text" class="entry-input bg-light-gray" placeholder="Project Lead" readonly></td>
                            <td class="p-4">
                                <div class="aia-custom-select-wrap">
                                    <div class="aia-select-trigger" onclick="toggleAiaSelect(this, event)">
                                        <span class="trigger-text">Location</span>
                                        <i class="bi bi-chevron-down"></i>
                                    </div>
                                    <div class="aia-select-popover">
                                        <div class="aia-select-option" data-id="0" data-value="AIA Central" onclick="selectAiaOption(this)">AIA Central (Office)</div>
                                        <div class="aia-select-option" data-id="1" data-value="WFH" onclick="selectAiaOption(this)">WFH</div>
                                    </div>
                                    <input type="hidden" class="aia-select-value" value="">
                                    <input type="hidden" class="aia-select-id" value="">
                                </div>
                            </td>
                            <td class="p-4 text-center">
                                <button class="btn btn-icon btn-light-danger btn-sm rounded-circle h-35px w-35px" onclick="this.closest('tr').remove();">
                                    <i class="bi bi-trash-fill"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="7" class="p-0" style="border-bottom: 0;">
                                <div class="p-6 border-top">
                                    <button class="btn-add-row" onclick="addNewLogEntry()">
                                        <i class="bi bi-plus-circle-fill"></i> Add Entry
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <!-- STICKY SAVE FOOTER (EXACT MATCH) -->
            <div class="save-footer-sticky">
                <div class="container-fluid d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center">
                        <div class="symbol symbol-45px symbol-circle me-4">
                            <span class="symbol-label bg-light-danger">
                                <i class="bi bi-clock-history text-danger fs-3"></i>
                            </span>
                        </div>
                        <div class="d-flex flex-column">
                            <span class="text-muted fw-boldest fs-8 text-uppercase">Total Logged Hours Today</span>
                            <span id="total_log_hours" class="text-dark fw-950 fs-4">00h 00m</span>
                        </div>
                    </div>
                    <div class="d-flex gap-4">
                        <button class="btn-standard-ghost" onclick="window.location.href='/Timesheet/Employee/Dashboard'">
                            Discard
                        </button>
                        <button class="btn-standard-primary" onclick="saveDailyTimesheet()">
                            <i class="bi bi-box-arrow-in-down"></i> Save Timesheet
                        </button>
                    </div>
                </div>
            </div>


        </div>
    </div>
</div>


@section Scripts {
    <script src="~/apps/modules/timesheet/js/timesheet-management.js" asp-append-version="true"></script>
    <script>
        // Variable to hold working rows so they aren't lost when toggling
        let stashedWorkingRows = "";

        // Function to handle the custom dropdown selection
        window.selectDayTypeToggle = function(val) {
            try {
                const hiddenInput = document.getElementById('day_type_select');
                if (hiddenInput) hiddenInput.value = val;

                const pillWorking = document.getElementById('pill_working');
                const pillOff = document.getElementById('pill_off');

                if (val === 'working') {
                    if (pillWorking) {
                        pillWorking.classList.add('active');
                        pillWorking.style.backgroundColor = '#F1F4F9';
                        pillWorking.style.color = '#181C32';
                    }
                    if (pillOff) {
                        pillOff.classList.remove('active');
                        pillOff.style.backgroundColor = 'transparent';
                        pillOff.style.color = '#A1A5B7';
                    }
                } else {
                    if (pillOff) {
                        pillOff.classList.add('active');
                        pillOff.style.backgroundColor = '#F1F4F9';
                        pillOff.style.color = '#181C32';
                    }
                    if (pillWorking) {
                        pillWorking.classList.remove('active');
                        pillWorking.style.backgroundColor = 'transparent';
                        pillWorking.style.color = '#A1A5B7';
                    }
                }

                const tbody = document.getElementById('log_entry_tbody');
                const tfoot = document.querySelector('.daily-master-table tfoot');
                
                if (!tbody) return;

                if (val === 'working') {
                    if (tfoot) tfoot.style.display = '';

                    if (stashedWorkingRows) {
                        tbody.innerHTML = stashedWorkingRows;
                    } else {
                        const offRows = tbody.querySelectorAll('.mock-off-row');
                        offRows.forEach(r => r.remove());

                        if (tbody.children.length === 0 && typeof window.addNewLogEntry === 'function') {
                            window.addNewLogEntry();
                        } else if (tbody.children.length === 0 && typeof addNewLogEntry === 'function') {
                            addNewLogEntry();
                        }
                    }
                } else if (val === 'off') {
                    if (tfoot) tfoot.style.display = 'none';

                    const currentRows = tbody.querySelectorAll('tr:not(.mock-off-row)');
                    if (currentRows.length > 0) {
                        stashedWorkingRows = tbody.innerHTML;
                    }

                    tbody.innerHTML = `
                        <tr class="align-middle mock-off-row">
                            <td colspan="7" class="p-0 position-relative" style="background-color: #f9f9f9;">
                                <!-- Text overlay -->
                                <div class="position-absolute w-100 h-100 d-flex align-items-center justify-content-center" style="top:0; left:0; z-index:10; background: rgba(249,249,249,0.7); backdrop-filter: blur(1px);">
                                    <span class="fs-2 fw-bolder text-gray-600" style="letter-spacing: -0.5px;">Day Off : No Activities required today</span>
                                </div>
                                <!-- Fake disabled row -->
                                <table class="w-100 m-0" style="opacity: 0.35; pointer-events: none; border: none; table-layout: fixed;">
                                    <tr>
                                        <td class="p-4 text-center" style="width: 110px; border-bottom: none;"><div class="entry-input text-center text-gray-400 mx-auto" style="width: 70px;">00 <span class="ms-1">h</span></div></td>
                                        <td class="p-4" style="width: 180px; border-bottom: none;"><div class="entry-input d-flex justify-content-between align-items-center px-3"><span class="text-gray-400">Select Project</span><i class="bi bi-chevron-down text-gray-400"></i></div></td>
                                        <td class="p-4" style="width: 120px; border-bottom: none;"><input type="text" class="entry-input bg-transparent" disabled></td>
                                        <td class="p-4" style="border-bottom: none;"><input type="text" class="entry-input bg-transparent px-3" placeholder="Describe what you do...." disabled></td>
                                        <td class="p-4" style="width: 150px; border-bottom: none;"><input type="text" class="entry-input bg-transparent" disabled></td>
                                        <td class="p-4" style="width: 140px; border-bottom: none;"><div class="entry-input d-flex justify-content-between align-items-center px-3"><span class="text-gray-400">Location</span><i class="bi bi-chevron-down text-gray-400"></i></div></td>
                                        <td class="p-4 text-center" style="width: 60px; border-bottom: none;"><i class="bi bi-trash text-danger" style="font-size:1.2rem;"></i></td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    `;
                }
            } catch (e) {
                console.error('Error toggling day type:', e);
            }
        };

        // Pill click handlers — run immediately (scripts load after DOM is parsed in this layout)
        function bindPills() {
            document.querySelectorAll('.day-type-pill').forEach(pill => {
                pill.addEventListener('click', function(e) {
                    e.preventDefault();
                    window.selectDayTypeToggle(this.getAttribute('data-value'));
                });
            });
        }
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', bindPills);
        } else {
            bindPills();
        }
    </script>
}

