@page "/Timesheet/Supervisor/Dashboard"
@model HRManagement.Web.Pages.Modules.Timesheet.Supervisor.DashboardModel
@using HRManagement.Web.Models.Shared
@{
    ViewData["Title"] = "Supervisor Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/apps/modules/timesheet/css/supervisor-review.css" asp-append-version="true" />
}

<div class="supervisor-dashboard-container">

    <!-- BREADCRUMB -->
    <nav class="mb-5" aria-label="breadcrumb">
        <ol class="breadcrumb" style="background: none; padding: 0; margin: 0; font-size: 0.8rem; font-weight: 600; gap: 6px;">
            <li class="breadcrumb-item" style="color: #9EA5B2;">
                <a href="/Timesheet/Supervisor/Dashboard" style="color: #9EA5B2; text-decoration: none;">Timesheet</a>
            </li>
            <li class="breadcrumb-item active" style="color: #D31145;" aria-current="page">Dashboard</li>
        </ol>
    </nav>

    <!-- 1. GREETING CARD -->
    <div class="greeting-card">
        <h1 id="welcome_text">Good Morning, Supervisor</h1>
        <p id="active_intern_count_label">0 active members</p>
    </div>

    <!-- 2. TOP 3 NEEDS APPROVAL -->
    <div class="dashboard-card mb-5" style="margin-bottom: 24px;">
        <div class="card-header-clean d-flex justify-content-between align-items-center">
            <div class="card-title-clean">
                <i class="bi bi-clock-history text-warning"></i> Needs Approval
                <span id="pending_count_badge" class="badge badge-light-warning fw-boldest ms-2 px-3 py-1 fs-9">0</span>
            </div>
            <a href="/Timesheet/Supervisor/Report" class="btn btn-sm btn-light fw-boldest" style="border-radius:8px; font-size:0.8rem;">
                View All <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
        <div class="card-body-clean" id="top_pending_container">
            <div class="text-center py-8" style="color: #C4CAD4; font-size: 0.85rem; font-weight: 600;">Loading...</div>
        </div>
    </div>


    <!-- 3. HOURS BREAKDOWN TABLE -->
    <div class="breakdown-card">
        <div class="breakdown-header">
            <div class="breakdown-title">
                <i class="bi bi-clock-history"></i> Intern Hours Breakdown
            </div>
            <select id="intern_filter_dropdown" class="form-select form-select-sm fw-bold"
                    style="width: 160px; border-radius: 8px; font-size: 0.82rem; border-color: #EAECF0; color: #4B5563;">
                <option value="">All Intern</option>
            </select>
        </div>
        <div style="overflow-x: auto;">
            <table class="breakdown-table">
                <thead>
                    <tr id="breakdown_header_row"></tr>
                </thead>
                <tbody id="breakdown_body"></tbody>
            </table>
        </div>
    </div>

    <!-- 4. MONTHLY ALLOCATION CHART -->
    <div class="dashboard-card" style="margin-bottom: 0;">
        <div class="chart-container">
            <div class="chart-title">Intern Monthly Application Allocation</div>
            <div class="row align-items-center">
                <div class="col-lg-5 d-flex justify-content-center">
                    <div class="donut-wrapper">
                        <canvas id="allocation_donut_chart"></canvas>
                        <div class="donut-text-center">
                            <div class="donut-val" id="donut_total_value">0%</div>
                            <div class="donut-lbl">Total Usage</div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-7 mt-5 mt-lg-0 ps-lg-6">
                    <div id="donut_legends"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- LIVE ACTIVITY FEED -->
    <div class="row mt-8">
        <div class="col-12">
            <div class="dashboard-card">
                <div class="card-header-clean">
                    <h3 class="card-title-clean">
                        <i class="bi bi-broadcast text-danger pulse-effect"></i> Live Employee Activity
                    </h3>
                    <div class="d-flex align-items-center gap-4">
                        <span class="badge badge-light-danger fw-boldest px-3 py-1 fs-9">LIVE MONITORING</span>
                        <button class="btn btn-icon btn-sm btn-light-primary rounded-circle" onclick="initSupervisorDashboard()">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body-clean">
                    <div class="table-responsive">
                        <table class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-4">
                            <thead>
                                <tr class="fw-boldest text-muted fs-8 text-uppercase">
                                    <th class="min-w-150px">Employee</th>
                                    <th class="min-w-140px">Project</th>
                                    <th class="min-w-200px">Latest Task Description</th>
                                    <th class="min-w-100px text-center">Duration</th>
                                    <th class="min-w-100px text-end">Log Date</th>
                                </tr>
                            </thead>
                            <tbody id="live_activity_tbody">
                                <!-- Loaded via JS -->
                                <tr><td colspan="5" class="text-center py-10 text-muted">Listening for activities...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js" asp-append-version="true"></script>
    <script src="~/apps/modules/timesheet/js/dashboard.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (typeof initSupervisorDashboard === 'function') initSupervisorDashboard();
        });
    </script>
}
