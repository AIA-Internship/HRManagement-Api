@page "/Timesheet/Supervisor/Dashboard"
@model HRManagement.Web.Pages.Modules.Timesheet.Supervisor.DashboardModel
@{
    ViewData["Title"] = "Supervisor Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/apps/modules/timesheet/css/supervisor-dashboard.css" asp-append-version="true" />
}

<div class="dashboard-wrapper">
    <!-- Top Bar / Header -->
    @await Html.PartialAsync("Layout/_PageHeader", new PageHeaderViewModel {
        Title = "Supervisor Dashboard",
        Subtitle = "Track intern progress and manage timesheet approvals",
        Id = "page_title_text",
        Breadcrumbs = new List<BreadcrumbItem> {
            new BreadcrumbItem { Title = "Timesheet", Url = "/Timesheet/Supervisor/Dashboard" },
            new BreadcrumbItem { Title = "Overview" }
        },
        RenderActions = Html.Raw("<div class='d-flex align-items-center gap-3 bg-white px-5 py-3 rounded-3 border'><div class='symbol-circle bg-light-brand text-brand' style='width:35px; height:35px;'><i class='bi bi-people-fill fs-6'></i></div><div><div class='fs-tiny fw-bold text-muted ls-1'>ACTIVE MEMBERS</div><div class='fs-5 fw-bold text-dark lh-1' id='active_intern_count'>0</div></div></div>")
    })

    <div class="row g-7 mt-2">
        <!-- MISSING TIMESHEETS -->
        <div class="col-xl-6">
            <div class="aia-card">
                <div class="card-header border-0 pt-6 pb-2">
                    <h3><i class="bi bi-info-circle text-danger me-2"></i> Missing Submissions</h3>
                    <span class="badge badge-light-danger fw-bold fs-tiny">URGENT</span>
                </div>
                <div class="card-body card-body-scroll pt-4" id="missing_list_container">
                    <div class="text-center py-10 opacity-25 fw-bold">Checking...</div>
                </div>
                <div class="p-6 text-center border-top">
                    <button class="btn btn-sm btn-primary-red w-75" onclick="window.location.href='/Timesheet/Supervisor/Review'">Go to Submission Review</button>
                </div>
            </div>
        </div>

        <!-- PENDING APPROVALS -->
        <div class="col-xl-6">
            <div class="aia-card">
                <div class="card-header border-0 pt-6 pb-2">
                    <h3><i class="bi bi-person-check text-brand me-2"></i> Pending Approvals</h3>
                    <span class="badge badge-light fw-bold fs-7" id="needs_review_count_stat">0 / 0</span>
                </div>
                <div class="card-body card-body-scroll pt-4" id="pending_approvals_list">
                    <div class="text-center py-10 opacity-25 fw-bold">Loading...</div>
                </div>
                <div class="p-6 text-center border-top">
                    <button class="btn btn-sm btn-light-grey w-75" onclick="window.location.href='/Timesheet/Supervisor/Report'">View Full History</button>
                </div>
            </div>
        </div>
    </div>

    <!-- HOURS BREAKDOWN -->
    <div class="aia-card mt-6">
        <div class="card-header border-0 pt-7">
            <h3><i class="bi bi-calendar3 text-brand me-2"></i> Intern Hours Breakdown</h3>
            <select id="intern_filter_dropdown" class="form-select form-select-sm" style="width: 200px;">
                <option value="">All Interns</option>
            </select>
        </div>
        <div class="table-responsive px-5">
            <table class="table-custom">
                <thead id="breakdown_header_row">
                    <!-- JS Injected -->
                </thead>
                <tbody id="breakdown_body">
                    <!-- JS Injected -->
                </tbody>
            </table>
        </div>
        <div class="p-6 text-center border-top">
            <span class="text-muted fs-tiny fw-bold">Totals based on approved monthly logs.</span>
        </div>
    </div>

    <!-- DONUT CHART -->
    <div class="aia-card mt-6 mb-0"> <!-- Removed mb-10 and set to 0. attempt 26 -->
        <div class="card-header border-0 pt-7">
            <h3><i class="bi bi-activity text-brand me-2"></i> Activity Allocation</h3>
        </div>
        <div class="card-body py-10">
            <div class="row align-items-center">
                <div class="col-lg-5 text-center">
                    <div class="position-relative d-inline-block" style="width: 250px; height: 250px;">
                        <canvas id="allocation_donut_chart"></canvas>
                        <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); pointer-events: none;">
                            <div class="fs-2 fw-bold text-dark">100%</div>
                            <div class="fs-tiny fw-bold text-muted mt-1">TOTAL USAGE</div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-7">
                    <div id="donut_legends" class="ps-10">
                        <!-- JS Injected -->
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js" asp-append-version="true"></script>
    <script src="~/apps/modules/timesheet/js/dashboard.js" asp-append-version="true"></script>
}
