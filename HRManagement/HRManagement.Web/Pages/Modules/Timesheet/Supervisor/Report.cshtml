@page "/Timesheet/Supervisor/Report"
@model HRManagement.Web.Pages.Modules.Timesheet.Supervisor.ReportModel
@using HRManagement.Web.Models.Shared
@{
    ViewData["Title"] = "Approval Management";
}

@section Styles {
    <link rel="stylesheet" href="~/apps/shared/badges/status-badges.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/apps/modules/timesheet/css/supervisor-review.css" asp-append-version="true" />
    <style>
        .approval-management-container {
            padding: 28px 32px;
            font-family: 'Inter', sans-serif;
        }

        /* ── Filter Card ── */
        .filter-card {
            background: #fff;
            border-radius: 14px;
            padding: 24px 28px;
            border: 1px solid #EAECF0;
            box-shadow: 0 1px 4px rgba(16,24,40,0.04);
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 20px;
        }

        .filter-group {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .filter-label {
            font-size: 0.75rem;
            font-weight: 700;
            color: #4B5563;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }


        /* ── Stats Summary ── */
        .stats-summary-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 24px;
            margin-bottom: 24px;
        }

        .stat-card {
            background: #fff;
            border-radius: 14px;
            padding: 20px 24px;
            border: 1px solid #EAECF0;
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
        }

        .stat-info {
            display: flex;
            flex-direction: column;
        }

        .stat-value {
            font-size: 1.5rem;
            font-weight: 800;
            color: #0D0F1C;
            line-height: 1;
        }

        .stat-label {
            font-size: 0.85rem;
            font-weight: 700;
            color: #9EA5B2;
            margin-top: 4px;
        }


        /* ── Table Styling ── */
        .approval-table-card {
            background: #fff;
            border-radius: 14px;
            border: 1px solid #EAECF0;
            overflow: hidden;
            box-shadow: 0 1px 4px rgba(16,24,40,0.04), 0 4px 16px rgba(16,24,40,0.03);
        }

        .approval-table {
            width: 100%;
            border-collapse: collapse;
        }

        .approval-table thead tr {
            background: #F8FAFC;
        }

        .approval-table th {
            padding: 16px 28px;
            font-size: 0.8rem;
            font-weight: 800;
            color: #7E8299;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            text-align: left;
            border-bottom: 1px solid #EAECF0;
        }

        .approval-table td {
            padding: 20px 28px;
            font-size: 0.95rem;
            color: #374151;
            border-bottom: 1px solid #F4F6F9;
            vertical-align: middle;
        }


        .approval-table tbody tr:last-child td {
            border-bottom: none;
        }

        .approval-table tbody tr {
            transition: background 0.15s;
            cursor: pointer;
        }

        .approval-table tbody tr:hover {
            background: #F8FAFC;
        }


        .employee-info {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .employee-avatar {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: #F4F6F9;
            color: var(--brand-red);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 0.95rem;
            flex-shrink: 0;
            border: 1px solid #EAECF0;
        }

        .employee-name {
            font-weight: 800;
            color: #181C32;
            font-size: 1rem;
            line-height: 1.2;
        }

        .employee-id {
            font-size: 0.8rem;
            color: #7E8299;
            font-weight: 700;
            margin-top: 2px;
        }

        .period-text {
            font-weight: 700;
            color: #4B5563;
        }

        .decision-date {
            font-size: 0.82rem;
            color: #6B7280;
            font-weight: 500;
        }

        .revision-note-tooltip {
            display: inline-block;
            margin-left: 6px;
            color: #9EA5B2;
            cursor: help;
        }
    </style>
}

<div class="d-flex flex-column flex-column-fluid mt-3 app-container-full page-wrapper-stretch">
    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div id="kt_app_content_container" class="app-container container-fluid d-flex flex-column flex-column-fluid">
    
    @await Html.PartialAsync("Layout/_PageHeader", new PageHeaderViewModel {
        Title = "Employee Approval Center",
        Subtitle = "Audit and track employee timesheet submissions and compliance",
        Breadcrumbs = new List<BreadcrumbItem> {
            new BreadcrumbItem { Title = "Timesheet", Url = "/Timesheet/Supervisor/Dashboard" },
            new BreadcrumbItem { Title = "Employee Approval Center" }
        }
    })


    <!-- STATS SUMMARY -->
    <div class="stats-summary-row mt-8">
        <div class="stat-card">
            <div class="stat-icon" style="background: #FFFBEB; color: #D97706;">
                <i class="bi bi-clock-history"></i>
            </div>
            <div class="stat-info">
                <span class="stat-value" id="stat_pending">0</span>
                <span class="stat-label">Pending Approval</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background: #ECFDF5; color: #059669;">
                <i class="bi bi-check-circle"></i>
            </div>
            <div class="stat-info">
                <span class="stat-value" id="stat_approved">0</span>
                <span class="stat-label">Approved</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background: #FFF1F2; color: #E11D48;">
                <i class="bi bi-chat-right-dots"></i>
            </div>
            <div class="stat-info">
                <span class="stat-value" id="stat_revision">0</span>
                <span class="stat-label">Need Revision</span>
            </div>
        </div>
    </div>

    <!-- FILTERS -->
    <div class="filter-card">
        <div class="d-flex gap-6 flex-wrap align-items-center">
            <div class="filter-group">
                <span class="filter-label">Month</span>
                <select id="filter_month" class="form-select form-select-solid form-select-sm fw-bold" style="width: 140px; border-radius: 8px;">
                    <option value="1">January</option><option value="2">February</option><option value="3">March</option><option value="4">April</option>
                    <option value="5">May</option><option value="6">June</option><option value="7">July</option><option value="8">August</option>
                    <option value="9">September</option><option value="10">October</option><option value="11">November</option><option value="12">December</option>
                </select>
            </div>
            <div class="filter-group">
                <span class="filter-label">Year</span>
                <select id="filter_year" class="form-select form-select-solid form-select-sm fw-bold" style="width: 110px; border-radius: 8px;">
                    <option value="2026">2026</option>
                    <option value="2025">2025</option>
                </select>
            </div>
            <div class="filter-group">
                <span class="filter-label">Status</span>
                <select id="filter_status" class="form-select form-select-solid form-select-sm fw-bold" style="width: 160px; border-radius: 8px;">
                    <option value="">All Status</option>
                    <option value="Waiting">Waiting</option>
                    <option value="Approved">Approved</option>
                    <option value="Need Revision">Need Revision</option>
                </select>
            </div>
        </div>
        <button class="btn-standard-info btn-standard-sm" onclick="loadApprovalData()">
            <i class="bi bi-arrow-clockwise"></i> Refresh
        </button>

    </div>

    <!-- APPROVAL TABLE -->
    <div class="approval-table-card">
        <div class="table-responsive">
            <table class="approval-table">
                <thead>
                    <tr>
                        <th style="width: 35%">INTERN</th>
                        <th style="width: 25%">MONTH/PERIOD</th>
                        <th style="width: 25%">APPROVAL STATUS</th>
                        <th style="width: 15%" class="text-end">EXPORT</th>
                    </tr>

                </thead>
                <tbody id="approval_tbody">
                    <!-- Dynamic Rows -->
                </tbody>
            </table>
        </div>
        
        <div id="approval_empty_state" style="display:none;" class="text-center py-20">
            <div class="mb-4">
                <i class="bi bi-inbox text-gray-200" style="font-size: 4rem;"></i>
            </div>
            <h4 class="fw-boldest text-gray-800">No submissions found</h4>
            <p class="text-gray-400 fw-bold">Try adjusting your filters or check back later.</p>
        </div>
    </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/apps/modules/timesheet/js/timesheet-management.js" asp-append-version="true"></script>
    <script src="~/apps/modules/timesheet/js/approval-management.js" asp-append-version="true"></script>
}
