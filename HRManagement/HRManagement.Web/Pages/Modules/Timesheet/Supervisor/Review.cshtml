@page "/Timesheet/Supervisor/Review"
@model HRManagement.Web.Pages.Modules.Timesheet.Supervisor.ReviewModel
@{
    ViewData["Title"] = "Approval Management";
}

@section Styles {
    <link rel="stylesheet" href="~/apps/shared/badges/status-badges.css" asp-append-version="true" />
    <style>
        :root { --brand-red: #bb1640; }
        .review-page-container {
            padding: 28px 32px;
            background-color: #F4F6F9;
            font-family: 'Inter', sans-serif;
            min-height: calc(100vh - 130px);
        }

        /* ── Header ── */
        .page-header-title { font-size: 1.5rem; font-weight: 800; color: #181C32; margin-bottom: 4px; }
        .page-header-subtitle { font-size: 0.9rem; color: #7E8299; font-weight: 500; }
        
        .toolbar-card {
            background: #fff;
            border-radius: 14px;
            padding: 16px 24px;
            border: 1px solid #EAECF0;
            margin-top: 24px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 1px 4px rgba(16,24,40,0.04);
        }

        .intern-selector {
            display: flex; flex-direction: column;
        }
        .intern-label { font-size: 0.7rem; font-weight: 700; color: #A1A5B7; letter-spacing: 0.5px; margin-bottom: 2px; }
        .intern-name { font-size: 1.1rem; font-weight: 800; color: #181C32; display: flex; align-items: center; gap: 8px; }
        .intern-dropdown-icon {
            width: 24px; height: 24px; border-radius: 50%; border: 1px solid #EAECF0;
            display: flex; align-items: center; justify-content: center; color: var(--brand-red);
        }

        .date-scroller {
            display: flex; align-items: center; gap: 16px; font-size: 1.1rem; font-weight: 800; color: #181C32;
        }
        .date-scroller i { color: var(--brand-red); font-size: 1.2rem; cursor: pointer; }
        .date-scroller-text { display: flex; align-items: center; gap: 8px; }

        .btn-submit-review {
            background-color: var(--brand-red); color: white; border-radius: 8px;
            font-weight: 700; padding: 10px 24px; border: none; font-size: 0.9rem;
        }
        .btn-submit-review:hover { background-color: #a01035; color: white; }

        /* ── Table Container ── */
        .log-table-card {
            background: #fff; border-radius: 14px;
            border: 1px solid #EAECF0; overflow: hidden;
            box-shadow: 0 1px 4px rgba(16,24,40,0.04);
        }
        .log-table { width: 100%; border-collapse: collapse; }
        .log-table th {
            padding: 14px 16px; background: #F8FAFC;
            font-size: 0.75rem; font-weight: 800; color: #7E8299;
            text-transform: uppercase; letter-spacing: 0.5px;
            border-bottom: 1px solid #EAECF0; text-align: left;
            white-space: nowrap;
        }
        .log-table td {
            padding: 14px 16px; font-size: 0.85rem; font-weight: 500;
            color: #374151; border-bottom: 1px solid #F4F6F9;
            vertical-align: top;
        }
        
        .row-weekend td { background: #FAFBFC !important; color: #B0B5C9; }
        
        .day-check {
            width: 16px; height: 16px; border-radius: 4px; cursor: pointer;
            accent-color: var(--brand-red);
        }
        .day-check:disabled { cursor: not-allowed; opacity: 0.5; }

        /* Status Pills */
        .status-pill {
            padding: 4px 12px; border-radius: 12px; font-size: 0.75rem; font-weight: 700; display: inline-block; white-space: nowrap;
        }
        .status-needs-approval { background: #FFF4E5; color: #FF9800; }
        .status-need-revision { background: #FFE0ED; color: var(--brand-red); }
        .status-approved { background: #E8FFF3; color: #10B981; }

        /* Multi-line cell spacing */
        .multi-line-cell { line-height: 1.8; }

        /* Remark Icon */
        .remark-icon-btn {
            background: none; border: none; padding: 4px;
            color: var(--brand-red); cursor: pointer; position: relative;
        }
        .remark-icon-btn.has-remark {
            color: var(--brand-red);
        }
        .remark-icon-btn.no-remark {
            color: #A1A5B7;
        }
        .remark-icon-btn:hover { color: #a01035; }
        
        /* Modal textarea */
        .remark-textarea {
            width: 100%; min-height: 100px; border-radius: 8px; border: 1px solid #EAECF0;
            padding: 12px; font-size: 0.9rem; resize: vertical; outline: none;
        }
        .remark-textarea:focus { border-color: var(--brand-red); }
        
        .log-table tr.row-weekend td { background-color: #F8F9FA !important; }
        .log-table tr.row-need-revision td { background-color: #F8F9FA !important; }

        /* SweetAlert Customizations V2 */
        .custom-swal-popup-v2 {
            border-radius: 16px !important;
            padding: 24px 32px 32px 32px !important;
            width: 500px !important;
        }
        .custom-swal-popup-v2 .swal2-title {
            padding: 0 !important;
            margin: 0 !important;
        }
        .custom-swal-popup-v2 .swal2-html-container {
            margin: 5px 0 15px 0 !important;
            padding: 0 !important;
        }
        .custom-swal-input-v2 {
            min-height: 80px !important;
            border-radius: 12px !important;
            border: 1px solid #D31145 !important;
            background-color: #ffffff !important;
            box-shadow: none !important;
            font-size: 1.05rem !important;
            color: #5E6278 !important;
            font-weight: 600 !important;
            padding: 16px !important;
            resize: none !important;
            margin: 0 !important;
            width: 100% !important;
        }
        .custom-swal-input-v2::placeholder {
            color: #A1A5B7 !important;
            font-weight: 700;
        }
        .custom-swal-input-v2:focus {
            outline: none !important;
            box-shadow: 0 0 0 3px rgba(211, 17, 69, 0.15) !important;
        }
        .custom-swal-btn {
            background-color: #D31145 !important;
            color: white !important;
            border: none !important;
            border-radius: 8px !important;
            font-weight: 800 !important;
            padding: 10px 32px !important;
            font-size: 1rem !important;
        }
        .custom-swal-popup-v2 .swal2-actions {
            margin-top: 24px !important;
            justify-content: flex-end !important;
            width: 100% !important;
        }

        /* CUSTOM DATERANGEPICKER STYLES */
        .daterangepicker {
            border-radius: 16px !important;
            border: 0 !important;
            box-shadow: 0 15px 45px rgba(0, 0, 0, 0.08) !important;
            padding: 15px !important;
            font-family: 'Inter', sans-serif !important;
            margin-top: 8px !important;
        }
        .daterangepicker .drp-buttons { display: none !important; }
        .daterangepicker .calendar-table th, .daterangepicker .calendar-table td {
            font-family: 'Inter', sans-serif !important;
            font-weight: 800 !important;
            border-radius: 0 !important;
            min-width: 36px;
            height: 36px;
            line-height: 36px;
        }
        .daterangepicker .calendar-table th {
            color: #A1A5B7 !important;
            font-size: 0.75rem !important;
            text-transform: uppercase;
        }
        .daterangepicker .calendar-table td {
            color: #181C32 !important;
            font-size: 0.95rem !important;
        }
        .daterangepicker .calendar-table td.off { color: #D8D8D8 !important; }
        
        html body div.daterangepicker .calendar-table td.in-range {
            background-color: #FFF5F8 !important;
            color: #D31145 !important;
        }
        html body div.daterangepicker .calendar-table td.active, 
        html body div.daterangepicker .calendar-table td.active:hover,
        html body div.daterangepicker .calendar-table td.start-date,
        html body div.daterangepicker .calendar-table td.end-date {
            background-color: #D31145 !important;
            color: #ffffff !important;
        }
        .daterangepicker td.start-date {
            border-radius: 50% 0 0 50% !important;
        }
        .daterangepicker td.end-date {
            border-radius: 0 50% 50% 0 !important;
        }
        .daterangepicker td.start-date.end-date {
            border-radius: 50% !important;
        }
        .daterangepicker .month {
            font-size: 1.1rem !important;
            color: #181C32 !important;
            font-weight: 800 !important;
        }
        .daterangepicker .prev span, .daterangepicker .next span {
            border-color: #A1A5B7 !important;
            border-width: 0 2px 2px 0 !important;
            padding: 4px !important;
        }
        .daterangepicker .prev, .daterangepicker .next {
            background: #F9FAFB !important;
            border-radius: 50% !important;
            height: 32px !important;
            width: 32px !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
        }
        .daterangepicker .prev:hover, .daterangepicker .next:hover {
            background: #F1F4F9 !important;
        }
    </style>
}

<div class="review-page-container">
    <!-- Breadcrumb -->
    <div class="mb-2 d-flex align-items-center gap-2 text-muted fs-8 fw-bold">
        <a href="/Timesheet/Supervisor/Report" class="text-muted text-hover-primary">Timesheet</a>
        <i class="bi bi-chevron-right fs-9"></i>
        <span class="fw-boldest" style="color:var(--brand-red);">Approval Management</span>
    </div>
    
    <h1 class="page-header-title">Approval Management</h1>
    <div class="page-header-subtitle">Manage your intern's approval</div>

    <!-- TOOLBAR -->
    <div class="toolbar-card">
        <div class="intern-selector">
            <div class="intern-label">INTERN</div>
            <div class="intern-name">
                <div class="intern-dropdown-icon"><i class="bi bi-chevron-down" style="font-size:0.75rem;"></i></div>
                <span id="employee_name">Loading...</span>
            </div>
        </div>

        <div class="date-scroller position-relative" style="background: #F4F7FB; border-radius: 20px; padding: 6px 12px; display: flex; align-items: center; gap: 10px;">
            <button class="btn btn-icon btn-sm btn-light h-30px w-30px rounded-circle" id="prev_period_btn" style="background: #fff; border: 1px solid #E1E3EA;"><i class="bi bi-chevron-left text-muted"></i></button>
            <div id="review_period_picker" style="cursor: pointer; display: flex; align-items: center; gap: 10px; padding: 0 10px;">
                <i class="bi bi-calendar3 text-danger fs-4"></i>
                <span id="review_period_label" style="font-weight: 800; font-size: 1.15rem; color: #181C32;">Loading...</span>
            </div>
            <button class="btn btn-icon btn-sm btn-light h-30px w-30px rounded-circle" id="next_period_btn" style="background: #fff; border: 1px solid #E1E3EA;"><i class="bi bi-chevron-right text-muted"></i></button>
        </div>

        <div>
            <button class="btn-submit-review" onclick="submitReview()">Submit Review</button>
        </div>
    </div>

    <!-- LOG TABLE -->
    <div class="log-table-card table-responsive">
        <table class="log-table">
            <thead>
                <tr>
                    <th class="text-center" style="width: 80px;">
                        APPROVAL<br>
                        <div class="form-check form-check-custom form-check-solid justify-content-center mt-2">
                            <input type="checkbox" id="select_all_cb" class="form-check-input h-20px w-20px" onchange="toggleSelectAll(this)">
                        </div>
                    </th>
                    <th style="width: 140px;">STATUS</th>
                    <th style="width: 100px;">DAY</th>
                    <th style="width: 100px;">DATE</th>
                    <th style="width: 80px;">DURATION</th>
                    <th style="width: 140px;">PROJECT</th>
                    <th style="width: 120px;">APPS USED</th>
                    <th style="width: 250px;">TASK DESCRIPTION</th>
                    <th style="width: 120px;">LOCATION</th>
                    <th class="text-center" style="width: 80px;">REMARK</th>
                </tr>
            </thead>
            <tbody id="review_tbody">
                <!-- Loaded via JS -->
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/apps/modules/timesheet/js/supervisor-review.js" asp-append-version="true"></script>
}
