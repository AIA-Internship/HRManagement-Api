@page "/Account/ForgotPassword"
@model HRManagement.Web.Pages.Account.ForgotPasswordModel
@{
    Layout = null;
    ViewData["Title"] = "Forgot Password";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password - HR Management AIA</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/apps/modules/account/css/authentication-styling.css" asp-append-version="true" />
</head>

<body class="login-page">

<div class="login-card">
    <h5 class="text-center fw-bold mb-2">Reset Password</h5>
    <p class="text-center text-muted small mb-4">
        Enter your email and date of birth to verify your identity
    </p>

    <form id="verifyForm" class="needs-validation" novalidate onsubmit="return handleVerify(event)">
        <!-- Email -->
        <div class="mb-3 text-start">
            <label class="form-label">Email</label>
            <input type="email" class="form-control" id="verifyEmail" placeholder="e.g. user@aia.com" required>
            <div class="invalid-feedback">
                Please enter a valid email address.
            </div>
        </div>

        <!-- Date of Birth -->
        <div class="mb-4 text-start">
            <label class="form-label">Date of Birth</label>
            <input type="date" class="form-control" id="verifyDob" required>
            <div class="invalid-feedback">
                Date of birth is required.
            </div>
        </div>

        <!-- Custom Error -->
        <div id="verifyError" class="text-danger small mb-3 d-none">
            Email and date of birth do not match.
        </div>

        <!-- Button -->
        <div class="text-center">
            <button type="submit" class="btn btn-login py-3" id="verifyBtn">
                Verify Identity
            </button>
        </div>
    </form>

    <!-- Back to Login -->
    <div class="mt-4 text-center">
        <a href="/Account/Login" class="forgot-link">← Back to Login</a>
    </div>
</div>

<!-- Error Modal -->
<div class="custom-modal" id="errorModal">
    <div class="modal-content-custom">
        <div class="modal-icon">✖</div>
        <h5 class="fw-bold mb-3">Invalid Credentials</h5>
        <p class="text-muted mb-5" id="errorModalMsg">We couldn't verify your details. Please check your email and date of birth, then try again</p>
        <button class="btn btn-danger w-100" onclick="closeErrorModal()">OK</button>
    </div>
</div>

<script>
    const API_BASE = "https://localhost:7089";

    async function handleVerify(e) {
        e.preventDefault();
        const form = document.getElementById("verifyForm");
        form.classList.add("was-validated");

        const emailEl = document.getElementById("verifyEmail");
        const dobEl = document.getElementById("verifyDob");
        emailEl.classList.remove("is-invalid");
        dobEl.classList.remove("is-invalid");

        if (!form.checkValidity()) return false;

        const email = emailEl.value.trim();
        const dob = dobEl.value;
        const errorEl = document.getElementById("verifyError");
        const btn = document.getElementById("verifyBtn");

        errorEl.classList.add("d-none");
        btn.disabled = true;

        try {
            const response = await fetch(API_BASE + "/api/auth/verify-forgot", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ email: email, dateOfBirth: dob })
            });

            const result = await response.json().catch(() => ({}));
            const isError = result?.isError ?? result?.IsError ?? !response.ok;
            const message = result?.statusMessage || result?.StatusMessage || "Verification failed.";

            if (response.ok && !isError) {
                sessionStorage.setItem("aia_reset_email", email);
                sessionStorage.setItem("aia_reset_dob", dob);
                window.location.href = "/Account/CreatePassword";
            } else {
                emailEl.classList.add("is-invalid");
                dobEl.classList.add("is-invalid");
                showErrorModal();
            }
        } catch (err) {
            console.error("Verify error:", err);
            alert("Failed to connect to Backend API (Port 7089). Please ensure the API project is running.");
        } finally {
            btn.disabled = false;
        }

        return false;
    }

    document.addEventListener("DOMContentLoaded", () => {
        ["verifyEmail", "verifyDob"].forEach(id => {
            document.getElementById(id).addEventListener("input", (e) => {
                e.target.classList.remove("is-invalid");
            });
        });
    });

    function showErrorModal() {
        document.getElementById("errorModalMsg").innerText = "We couldn't verify your details. Please check your email and date of birth, then try again";
        document.getElementById("errorModal").style.display = "flex";
    }

    function closeErrorModal() {
        document.getElementById("errorModal").style.display = "none";
    }
</script>

</body>
</html>
