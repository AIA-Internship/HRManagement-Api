@page "/Account/ForgotPassword"
@model HRManagement.Web.Pages.Account.ForgotPasswordModel
@{
    Layout = null;
    ViewData["Title"] = "Forgot Password";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password - HR Management AIA</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/apps/css/account/style.css" asp-append-version="true" />
</head>

<body class="login-page">

<div class="login-card">
    <h5 class="text-center fw-bold mb-2">Reset Password</h5>
    <p class="text-center text-muted small mb-4">
        Enter your email and date of birth to verify your identity
    </p>

    <form id="verifyForm" class="needs-validation" novalidate onsubmit="return handleVerify(event)">
        <!-- Email -->
        <div class="mb-3 text-start">
            <label class="form-label">Email</label>
            <input type="email" class="form-control" id="verifyEmail" placeholder="e.g. user@aia.com" required>
            <div class="invalid-feedback">
                Please enter a valid email address.
            </div>
        </div>

        <!-- Date of Birth -->
        <div class="mb-4 text-start">
            <label class="form-label">Date of Birth</label>
            <input type="date" class="form-control" id="verifyDob" required>
            <div class="invalid-feedback">
                Date of birth is required.
            </div>
        </div>

        <!-- Custom Error -->
        <div id="verifyError" class="text-danger small mb-3 d-none">
            Email and date of birth do not match.
        </div>

        <!-- Button -->
        <div class="text-center">
            <button type="submit" class="btn btn-login py-3">
                Verify Identity
            </button>
        </div>
    </form>

    <!-- Back to Login -->
    <div class="mt-4 text-center">
        <a href="/Account/Login" class="forgot-link">← Back to Login</a>
    </div>
</div>

<script>
    function handleVerify(e) {
        e.preventDefault();
        const form = document.getElementById("verifyForm");
        form.classList.add("was-validated");

        if (!form.checkValidity()) return false;

        const email = document.getElementById("verifyEmail").value;
        const dob = document.getElementById("verifyDob").value;

        // Mock verification with new email
        if (email === "admin@aia.com" && dob === "2000-01-01") {
            window.location.href = "/Account/CreatePassword";
        } else {
            document.getElementById("verifyError").classList.remove("d-none");
        }
        return false;
    }
</script>

</body>
</html>
