@page "/Account/CreatePassword"
@model HRManagement.Web.Pages.Account.CreatePasswordModel
@{
    Layout = null;
    ViewData["Title"] = "Create New Password";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create New Password - HR Management AIA</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/apps/modules/account/css/authentication-styling.css" asp-append-version="true" />
</head>

<body class="login-page">

<div class="login-card">
    <h5 class="text-center fw-bold mb-2">Create New Password</h5>
    <p class="text-center text-muted small mb-4">
        Your new password must be different from your previous password
    </p>

    <form id="resetForm" class="needs-validation" novalidate onsubmit="return handleReset(event)">
        <!-- New Password -->
            <label class="form-label">New Password</label>
            <div class="input-group">
                <input type="password" class="form-control" id="newPassword" required minlength="8" placeholder="Enter new password">
                <button class="btn btn-outline-secondary" type="button" onclick="togglePass('newPassword')">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
        </div>
        </div>

        <!-- Confirm Password -->
            <label class="form-label">Confirm Password</label>
            <div class="input-group">
                <input type="password" class="form-control" id="confirmPassword" required placeholder="Confirm new password">
                <button class="btn btn-outline-secondary" type="button" onclick="togglePass('confirmPassword')">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
            <div id="confirmMismatch" class="text-danger small mt-2 d-none">
                Passwords does not match.
            </div>
        </div>

        <!-- Custom Error -->
        <div id="passwordError" class="text-danger small mb-3 d-none">
            Password does not match.
        </div>

        <!-- Button -->
        <div class="text-center mt-5">
                Change Password
            </button>
        </div>
    </form>

    <div class="mt-4 text-center">
        <a href="/Account/Login" class="forgot-link">← Back to Login</a>
    </div>
</div>

<!-- Success Modal -->
<div class="custom-modal" id="successModal">
    <div class="modal-content-custom">
        <h5 class="fw-bold mb-3">Password Changed Successfully</h5>
        <p class="text-muted mb-5">Your password has been successfully changed. Please login using your new password.</p>
        <button class="btn btn-login w-100" onclick="goToLogin()">Back to Login</button>
    </div>
</div>

<script>
    const API_BASE = "https://localhost:7089";

    // Guard: must come from verified Forgot Password flow
    (function () {
        const email = sessionStorage.getItem("aia_reset_email");
        if (!email) {
            window.location.href = "/Account/ForgotPassword";
        }
    })();

    function togglePass(id) {
        const inp = document.getElementById(id);
        inp.type = inp.type === "password" ? "text" : "password";
    }

        e.preventDefault();
        const errorDiv = document.getElementById("passwordError");
        const mismatchDiv = document.getElementById("confirmMismatch");
        const btn = document.getElementById("resetBtn");
        const email = sessionStorage.getItem("aia_reset_email");

        errorDiv.classList.add("d-none");
        mismatchDiv.classList.add("d-none");
        newPwEl.classList.remove("is-invalid");
        confirmPwEl.classList.remove("is-invalid");

        if (!email) {
            errorDiv.innerText = "Session expired. Please verify your identity again.";
            errorDiv.classList.remove("d-none");
            setTimeout(() => window.location.href = "/Account/ForgotPassword", 1500);
            return false;
        }

        if (newPassword.length === 0 && confirmPassword.length === 0) {
            newPwEl.classList.add("is-invalid");
            confirmPwEl.classList.add("is-invalid");
            return false;
        }

            errorDiv.classList.remove("d-none");
            return false;
        }

        if (newPassword !== confirmPassword) {
                errorDiv.classList.remove("d-none");
            }
        } catch (err) {
            console.error("Reset error:", err);
            alert("Failed to connect to Backend API (Port 7089). Please ensure the API project is running.");
        } finally {
            btn.disabled = false;
        }

        return false;
    }

        window.location.href = "/Account/Login";
        return false;
    }
</script>

</body>
</html>
