@page "/Account/CreatePassword"
@model HRManagement.Web.Pages.Account.CreatePasswordModel
@{
    Layout = null;
    ViewData["Title"] = "Create New Password";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create New Password - HR Management AIA</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/apps/modules/account/css/authentication-styling.css" asp-append-version="true" />
</head>

<body class="login-page">

<div class="login-card">
    <h5 class="text-center fw-bold mb-2">Create New Password</h5>
    <p class="text-center text-muted small mb-4">
        Your new password must be different from your previous password
    </p>

    <form id="resetForm" class="needs-validation" novalidate onsubmit="return handleReset(event)">
        <!-- New Password -->
        <div class="mb-4 text-start">
            <label class="form-label">New Password</label>
            <div class="input-group">
                <input type="password" class="form-control" id="newPassword" required minlength="8" placeholder="Enter new password">
                <button class="btn btn-outline-secondary" type="button" onclick="togglePass('newPassword')">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
            <div class="invalid-feedback">
                Password must be at least 8 characters.
            </div>
        </div>

        <!-- Confirm Password -->
        <div class="mb-4 text-start">
            <label class="form-label">Confirm Password</label>
            <div class="input-group">
                <input type="password" class="form-control" id="confirmPassword" required placeholder="Confirm new password">
                <button class="btn btn-outline-secondary" type="button" onclick="togglePass('confirmPassword')">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
        </div>

        <!-- Custom Error -->
        <div id="passwordError" class="text-danger small mb-3 d-none">
            Password does not match.
        </div>

        <!-- Button -->
        <div class="text-center mt-5">
            <button type="submit" class="btn btn-login py-3">
                Change Password
            </button>
        </div>
    </form>

    <div class="mt-4 text-center">
        <a href="/Account/Login" class="forgot-link">← Back to Login</a>
    </div>
</div>

<script>
    function togglePass(id) {
        const inp = document.getElementById(id);
        inp.type = inp.type === "password" ? "text" : "password";
    }

    function handleReset(e) {
        e.preventDefault();
        const newPassword = document.getElementById("newPassword").value;
        const confirmPassword = document.getElementById("confirmPassword").value;
        const errorDiv = document.getElementById("passwordError");

        errorDiv.classList.add("d-none");

        if (newPassword.length < 8) {
            errorDiv.innerText = "Password must be at least 8 characters.";
            errorDiv.classList.remove("d-none");
            return false;
        }

        if (newPassword !== confirmPassword) {
            errorDiv.innerText = "Password confirmation does not match.";
            errorDiv.classList.remove("d-none");
            return false;
        }

        alert("Password successfully changed!");
        window.location.href = "/Account/Login";
        return false;
    }
</script>

</body>
</html>
