    function allRulesMet(pw) {
        return pw.length >= 8
            && /[A-Za-z]/.test(pw)
            && /[0-9]/.test(pw)
            && /[a-z]/.test(pw)
            && /[A-Z]/.test(pw);
    }

    function setRule(id, ok, neutral) {
        const el = document.getElementById(id);
        if (!el) return;
        const icon = el.querySelector("i");
        el.classList.remove("text-muted", "text-success", "text-danger");
        icon.className = "me-2 bi";
        if (neutral) {
            el.classList.add("text-muted");
            icon.classList.add("bi-circle");
        } else if (ok) {
            el.classList.add("text-success");
            icon.classList.add("bi-check-circle-fill");
        } else {
            el.classList.add("text-danger");
            icon.classList.add("bi-x-circle-fill");
        }
    }

    function updateRuleChecklist() {
        const pw = document.getElementById("newPassword").value;
        const empty = pw.length === 0;

        setRule("rule-length", pw.length >= 8, empty);
        setRule("rule-letter-number", /[A-Za-z]/.test(pw) && /[0-9]/.test(pw), empty);
        setRule("rule-case", /[a-z]/.test(pw) && /[A-Z]/.test(pw), empty);
    }

