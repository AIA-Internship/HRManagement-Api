<html lang="en">
<!--begin::Head-->
<head>
	<base href="./" />
	<title>AIA - HR Management & Timesheet</title>
	<meta charset="utf-8" />
	<meta name="description" content="Advanced AIA HR Management & Timesheet System." />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<link rel="shortcut icon" href="/assets/media/logos/favicon.ico" />
	<!--begin::Fonts(mandatory for all pages)-->
	<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Inter:300,400,500,600,700,800,900" />
	<!--end::Fonts-->
	<!--begin::Global Stylesheets Bundle(mandatory for all pages)-->
	<link href="/assets/plugins/global/plugins.bundle.css" rel="stylesheet" type="text/css" />
	<link href="/assets/css/style.bundle.css" rel="stylesheet" type="text/css" />
	<!--end::Global Stylesheets Bundle-->
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
	
	<!-- 1. CORE BRAND IDENTITY -->
	<link href="/apps/shared/identity/brand-identity-tokens.css" rel="stylesheet" type="text/css" asp-append-version="true" />
	
	<!-- 2. GLOBAL UI COMPONENTS -->
	<link href="/apps/shared/buttons/standard-action-buttons.css" rel="stylesheet" type="text/css" asp-append-version="true" />
	<link href="/apps/shared/badges/status-badges.css" rel="stylesheet" type="text/css" asp-append-version="true" />
	<link href="/apps/shared/notifications/global-toast-notifications.css" rel="stylesheet" type="text/css" asp-append-version="true" />
	<link href="/apps/shared/forms/common-input-dropdowns.css" rel="stylesheet" type="text/css" asp-append-version="true" />
	<link href="/apps/shared/forms/aia-datepicker.css" rel="stylesheet" type="text/css" asp-append-version="true" />

	<link href="/apps/shared/layout/base-layout-styling.css" rel="stylesheet" type="text/css" asp-append-version="true" />
	<link href="/apps/shared/layout/centralized-page-header.css" rel="stylesheet" type="text/css" asp-append-version="true" />
	<link href="/apps/shared/modals/confirmation-action-modals.css" rel="stylesheet" type="text/css" asp-append-version="true" />
	<link href="/apps/shared/footers/standard-corporate-footers.css" rel="stylesheet" type="text/css" asp-append-version="true" />

	@await RenderSectionAsync("Styles", required: false)
</head>
<!--end::Head-->
<!--begin::Body-->
<body id="kt_app_body" data-kt-app-layout="light-sidebar" data-kt-app-header-fixed="true" data-kt-app-sidebar-enabled="true" data-kt-app-sidebar-fixed="true" data-kt-app-sidebar-hoverable="true" data-kt-app-sidebar-push-header="true" data-kt-app-sidebar-push-toolbar="true" data-kt-app-sidebar-push-footer="true" data-kt-app-toolbar-enabled="true" class="app-default">
	<script>var defaultThemeMode = "light"; var themeMode; if ( document.documentElement ) { if ( document.documentElement.hasAttribute("data-bs-theme-mode")) { themeMode = document.documentElement.getAttribute("data-bs-theme-mode"); } else { if ( localStorage.getItem("data-bs-theme") !== null ) { themeMode = localStorage.getItem("data-bs-theme"); } else { themeMode = defaultThemeMode; } } if (themeMode === "system") { themeMode = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"; } document.documentElement.setAttribute("data-bs-theme", themeMode); }</script>
	
	<div class="d-flex flex-column flex-root app-root" id="kt_app_root">
		<div class="app-page flex-column flex-column-fluid" id="kt_app_page">
			@* We prefer the organized subfolders for partials from the Timesheet refactor *@
			@await Html.PartialAsync("Layout/_PartialHeader")
			
			<div class="app-wrapper flex-column flex-row-fluid" id="kt_app_wrapper">
				@await Html.PartialAsync("Layout/_PartialSideBar")
				
				<div class="app-main flex-column flex-row-fluid" id="kt_app_main">
					@RenderBody()
					
					<div id="kt_app_footer" class="app-footer">
						<div class="app-container container-fluid d-flex flex-column flex-md-row flex-center flex-md-stack py-3">
							<div class="text-gray-900 order-2 order-md-1">
								<span class="text-muted fw-semibold me-1">2026&copy;</span>
								<a href="#" class="text-gray-800 text-hover-primary text-uppercase">AIA HR Management</a>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Modal Placeholder -->
	@await Html.PartialAsync("Modals/_PartialModal")
	@await Html.PartialAsync("Layout/_CalendarPopovers")

	<!-- Global Scritps -->
	<script src="/assets/plugins/global/plugins.bundle.js"></script>
	<script src="/assets/js/scripts.bundle.js"></script>
	<script src="/apps/shared/core/shared-global-logic.js" asp-append-version="true"></script>

	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
