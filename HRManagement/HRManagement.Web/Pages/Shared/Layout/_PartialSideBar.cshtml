@{
    var currentPath = ViewContext.HttpContext.Request.Path.Value;
}

<style>
    /* Prevent Sidebar UI Flashing */
    html[data-user-role="supervisor"] #intern_section { display: none !important; }
    html[data-user-role="supervisor"] #supervisor_section { display: block !important; }

    html[data-user-role="intern"] #supervisor_section { display: none !important; }
    html[data-user-role="intern"] #intern_section { display: block !important; }

    /* Footer user block collapses with the sidebar */
    [data-kt-app-sidebar-minimize="on"] #kt_app_sidebar_footer { padding-left: 0 !important; padding-right: 0 !important; }
    [data-kt-app-sidebar-minimize="on"] #kt_app_sidebar_footer .footer-user-trigger { justify-content: center; }
    [data-kt-app-sidebar-minimize="on"] #kt_app_sidebar_footer .footer-user-avatar { margin-right: 0 !important; }
    [data-kt-app-sidebar-minimize="on"] #kt_app_sidebar_footer .footer-user-info,
    [data-kt-app-sidebar-minimize="on"] #kt_app_sidebar_footer .footer-user-chevron { display: none !important; }

    /* On hover-expand, restore the full footer user block */
    [data-kt-app-sidebar-minimize="on"] #kt_app_sidebar:hover #kt_app_sidebar_footer { padding-left: 1.5rem !important; padding-right: 1.5rem !important; }
    [data-kt-app-sidebar-minimize="on"] #kt_app_sidebar:hover #kt_app_sidebar_footer .footer-user-trigger { justify-content: flex-start; }
    [data-kt-app-sidebar-minimize="on"] #kt_app_sidebar:hover #kt_app_sidebar_footer .footer-user-avatar { margin-right: 0.75rem !important; }
    [data-kt-app-sidebar-minimize="on"] #kt_app_sidebar:hover #kt_app_sidebar_footer .footer-user-info { display: flex !important; }
    [data-kt-app-sidebar-minimize="on"] #kt_app_sidebar:hover #kt_app_sidebar_footer .footer-user-chevron { display: block !important; }
</style>

<script>
    // Execute synchronously before the DOM to paint the correct menu instantly
    (function() {
        try {
            const u = window.aiaAuth ? window.aiaAuth.getUserInfo() : null;
            if (u) {
                const role = u.role || u["http://schemas.microsoft.com/ws/2008/06/identity/claims/role"] || "";
                const roleId = u.role_id || "";

                const isSupervisor = (
                    String(role).toLowerCase() === "supervisor" ||
                    String(role) === "0" ||
                    String(roleId) === "0"
                );
                
                document.documentElement.setAttribute('data-user-role', isSupervisor ? 'supervisor' : 'intern');
            }
        } catch(e) {}
    })();
</script>

