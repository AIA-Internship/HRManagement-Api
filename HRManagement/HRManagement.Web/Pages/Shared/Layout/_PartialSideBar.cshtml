@{
    var currentPath = ViewContext.HttpContext.Request.Path.Value ?? "";
}

<style>
    /* Prevent Sidebar UI Flashing */
    html[data-user-role="supervisor"] #intern_section { display: none !important; }
    html[data-user-role="supervisor"] #supervisor_section { display: block !important; }
    
    html[data-user-role="intern"] #supervisor_section { display: none !important; }
    html[data-user-role="intern"] #intern_section { display: block !important; }
</style>

<script>
    // Execute synchronously before the DOM to paint the correct menu instantly
    (function() {
        try {
            const userInfoRaw = localStorage.getItem('aia_user_info');
            if (userInfoRaw) {
                const u = JSON.parse(userInfoRaw);
                const role = u.role || u["http://schemas.microsoft.com/ws/2008/06/identity/claims/role"] || "";
                const roleId = u.role_id || "";
                const email = u.email || u["http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress"] || "";
                
                const isSupervisor = (
                    String(role).toLowerCase() === "supervisor" ||
                    String(role) === "0" ||
                    String(roleId) === "0" ||
                    String(email).toLowerCase() === "brandon@aia.com"
                );
                
                document.documentElement.setAttribute('data-user-role', isSupervisor ? 'supervisor' : 'intern');
            }
        } catch(e) {}
    })();
</script>

<div id="kt_app_sidebar" class="app-sidebar flex-column" data-kt-drawer="true" data-kt-drawer-name="app-sidebar" data-kt-drawer-activate="{default: true, lg: false}" data-kt-drawer-overlay="true" data-kt-drawer-width="225px" data-kt-drawer-direction="start" data-kt-drawer-toggle="#kt_app_sidebar_mobile_toggle">
    <!--begin::Logo-->
    <div class="app-sidebar-logo px-9" id="kt_app_sidebar_logo">
        <a href="/">
            <img alt="Logo" src="/assets/media/logos/logo.png" class="h-50px app-sidebar-logo-default" />
            <img alt="Logo" src="/assets/media/logos/logo.png" class="h-25px app-sidebar-logo-minimize" />
        </a>
        <!--end::Logo image-->
        
        <!--begin::Sidebar toggle-->
        <div id="kt_app_sidebar_toggle" class="app-sidebar-toggle btn btn-icon btn-shadow btn-sm btn-color-muted btn-active-color-primary h-30px w-30px position-absolute top-50 start-100 translate-middle rotate" data-kt-toggle="true" data-kt-toggle-state="active" data-kt-toggle-target="body" data-kt-toggle-name="app-sidebar-minimize">
            <i class="bi bi-chevron-left fs-3 rotate-180"></i>
        </div>
        <!--end::Sidebar toggle-->
    </div>
    <!--end::Logo-->

    <!--begin::sidebar menu-->
    <div class="app-sidebar-menu overflow-hidden flex-column-fluid">
        <!--begin::Menu wrapper-->
        <div id="kt_app_sidebar_menu_wrapper" class="app-sidebar-wrapper">
            <!--begin::Scroll wrapper-->
            <div id="kt_app_sidebar_menu_scroll" class="scroll-y mt-2 mb-5 mx-3" data-kt-scroll="true" data-kt-scroll-activate="true" data-kt-scroll-height="auto" data-kt-scroll-dependencies="#kt_app_sidebar_logo, #kt_app_sidebar_footer" data-kt-scroll-wrappers="#kt_app_sidebar_menu" data-kt-scroll-offset="5px" data-kt-scroll-save-state="true">
                <!--begin::Menu-->
                <div class="menu menu-column menu-rounded menu-sub-indention fw-semibold fs-6" id="#kt_app_sidebar_menu" data-kt-menu="true" data-kt-menu-expand="false">
                    
                    <div id="intern_section">
                    <!-- Divider -->
                    <div class="menu-item pt-2">
                        <div class="menu-content">
                            <span class="menu-heading fw-bold text-uppercase fs-7 text-muted border-bottom w-100 pb-2 mb-3">AIA ESS</span>
                        </div>
                    </div>

                    <!-- Profile Section -->
                    <div data-kt-menu-trigger="click" class="menu-item menu-accordion here show">
                        <span class="menu-link">
                            <span class="menu-icon">
                                <i class="ki-duotone ki-address-book fs-2">
                                    <span class="path1"></span>
                                    <span class="path2"></span>
                                    <span class="path3"></span>
                                </i>
                            </span>
                            <span class="menu-title">Profile</span>
                            <span class="menu-arrow"></span>
                        </span>
                        
                        <div class="menu-sub menu-sub-accordion show">
                            <div class="menu-item">
                                <a class="menu-link @(currentPath == "/Profile" ? "active" : "")" href="/Profile">
                                    <span class="menu-bullet">
                                        <span class="bullet bullet-dot"></span>
                                    </span>
                                    <span class="menu-title">Personal Information</span>
                                </a>
                            </div>
                            <div class="menu-item">
                                <a class="menu-link @(currentPath == "/Profile/History" ? "active" : "")" href="/Profile/History">
                                    <span class="menu-bullet">
                                        <span class="bullet bullet-dot"></span>
                                    </span>
                                    <span class="menu-title">Request History</span>
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Timesheet Submenu -->
                    <div data-kt-menu-trigger="click" class="menu-item menu-accordion @(currentPath.Contains("/Timesheet") ? "here show" : "")">
                        <span class="menu-link">
                            <span class="menu-icon">
                                <i class="ki-duotone ki-calendar-8 fs-2">
                                    <span class="path1"></span>
                                    <span class="path2"></span>
                                    <span class="path3"></span>
                                    <span class="path4"></span>
                                    <span class="path5"></span>
                                    <span class="path6"></span>
                                </i>
                            </span>
                            <span class="menu-title">Timesheet</span>
                            <span class="menu-arrow"></span>
                        </span>
                        
                        <div class="menu-sub menu-sub-accordion @(currentPath.Contains("/Timesheet") ? "show" : "")">
                            <div class="menu-item">
                                <a class="menu-link @(currentPath == "/Timesheet/Employee/Dashboard" ? "active" : "")" href="/Timesheet/Employee/Dashboard">
                                    <span class="menu-bullet">
                                        <span class="bullet bullet-dot"></span>
                                    </span>
                                    <span class="menu-title">Dashboard</span>
                                </a>
                            </div>
                            <div class="menu-item">
                                <a class="menu-link @(currentPath.Contains("/Timesheet/Employee/Management") || currentPath == "/Timesheet/Employee/Entry" ? "active" : "")" href="/Timesheet/Employee/Management">
                                    <span class="menu-bullet">
                                        <span class="bullet bullet-dot"></span>
                                    </span>
                                    <span class="menu-title">Logbook</span>
                                </a>
                            </div>
                            <div class="menu-item">
                                <a class="menu-link @(currentPath == "/Timesheet/Employee/Report" ? "active" : "")" href="/Timesheet/Employee/Report">
                                    <span class="menu-bullet">
                                        <span class="bullet bullet-dot"></span>
                                    </span>
                                    <span class="menu-title">Report</span>
                                </a>
                            </div>
                        </div>
                    </div>
                    </div>

                    <div id="supervisor_section" style="display: none;">
                        <div class="menu-item pt-5 pb-2"></div>

                        <!-- Timesheet Supervisor Submenu -->
                        <div data-kt-menu-trigger="click" class="menu-item menu-accordion @(currentPath.Contains("/Timesheet/Supervisor") ? "here show" : "")">
                            <span class="menu-link">
                                <span class="menu-icon">
                                    <i class="ki-duotone ki-calendar-8 fs-2">
                                        <span class="path1"></span>
                                        <span class="path2"></span>
                                        <span class="path3"></span>
                                        <span class="path4"></span>
                                        <span class="path5"></span>
                                        <span class="path6"></span>
                                    </i>
                                </span>
                                <span class="menu-title" style="font-size: 1.1rem; font-weight: 600;">Timesheet</span>
                                <span class="menu-arrow"></span>
                            </span>
                            
                            <div class="menu-sub menu-sub-accordion @(currentPath.Contains("/Timesheet/Supervisor") ? "show" : "")">
                                
                                <!-- Dashboard -->
                                <div class="menu-item">
                                    <a class="menu-link @(currentPath == "/Timesheet/Supervisor/Dashboard" ? "active" : "")" href="/Timesheet/Supervisor/Dashboard">
                                        <span class="menu-bullet">
                                            <span class="bullet bullet-dot"></span>
                                        </span>
                                        <span class="menu-title">Dashboard</span>
                                    </a>
                                </div>

                                <!-- Timesheet / Logbook -->
                                <div class="menu-item">
                                    <a class="menu-link @(currentPath == "/Timesheet/Supervisor/Timesheet" ? "active" : "")" href="/Timesheet/Supervisor/Timesheet">
                                        <span class="menu-bullet">
                                            <span class="bullet bullet-dot"></span>
                                        </span>
                                        <span class="menu-title">Employee Timesheet</span>
                                    </a>
                                </div>

                                <!-- Approval Management -->
                                <div class="menu-item">
                                    <a class="menu-link @(currentPath == "/Timesheet/Supervisor/Report" ? "active" : "")" href="/Timesheet/Supervisor/Report">
                                        <span class="menu-bullet">
                                            <span class="bullet bullet-dot"></span>
                                        </span>
                                        <span class="menu-title">Approval Management</span>
                                    </a>
                                </div>

                                <!-- Master Project -->
                                <div class="menu-item">
                                    <a class="menu-link @(currentPath.StartsWith("/Timesheet/Supervisor/Projects") ? "active" : "")" href="/Timesheet/Supervisor/Projects">
                                        <span class="menu-bullet">
                                            <span class="bullet bullet-dot"></span>
                                        </span>
                                        <span class="menu-title">Master Project</span>
                                    </a>
                                </div>

                                <!-- Master Holiday -->
                                <div class="menu-item">
                                    <a class="menu-link @(currentPath.StartsWith("/Timesheet/Supervisor/Holiday") ? "active" : "")" href="/Timesheet/Supervisor/Holiday">
                                        <span class="menu-bullet">
                                            <span class="bullet bullet-dot"></span>
                                        </span>
                                        <span class="menu-title">Master Holiday</span>
                                    </a>
                                </div>

                            </div>
                        </div>
                    </div>

                </div>
                <!--end::Menu-->
            </div>
            <!--end::Scroll wrapper-->
        </div>
        <!--end::Menu wrapper-->
    </div>
    <!--end::sidebar menu-->

    <!--begin::Footer-->
    <div class="app-sidebar-footer flex-column-auto pt-4 pb-6 px-6" id="kt_app_sidebar_footer" style="border-top: 1px solid #efefef;">
        <div class="d-flex align-items-center">
            <!--begin::Avatar-->
            <div class="symbol symbol-circle symbol-40px me-3">
                <div class="symbol-label fs-3 bg-light-danger text-danger fw-bold">P</div>
            </div>
            <!--end::Avatar-->
            <!--begin::Info-->
            <div class="d-flex flex-column">
                <span class="text-gray-800 fw-bold fs-7" id="sidebarUserName">Pulkeria Mayriel R.</span>
                <span class="text-muted fw-semibold fs-8" id="sidebarUserId">E123456</span>
            </div>
            <!--end::Info-->
        </div>
    </div>
    <!--end::Footer-->
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const userInfoRaw = localStorage.getItem('aia_user_info');
        if (userInfoRaw) {
            const userInfo = JSON.parse(userInfoRaw);
            
            // Update sidebar profile info
            const nameEl = document.getElementById('sidebarUserName');
            const idEl = document.getElementById('sidebarUserId');
            if (nameEl) nameEl.textContent = userInfo.fullName || userInfo.email;
            if (idEl) idEl.textContent = userInfo.nik || userInfo.employeeDisplayId || '---';
        }
    });
</script>
