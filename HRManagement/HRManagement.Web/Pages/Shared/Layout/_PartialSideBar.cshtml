<script>
    document.addEventListener('DOMContentLoaded', function() {
        const userInfo = window.aiaAuth ? window.aiaAuth.getUserInfo() : null;
        if (userInfo) {
            const fullName = userInfo.fullname || userInfo.fullName || userInfo.unique_name
                || userInfo["http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name"]
                || userInfo.email || "User";
            const email = userInfo.email
                || userInfo["http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress"]
                || "";
            const nameEl = document.getElementById('sidebarUserName');
            const idEl = document.getElementById('sidebarUserId');
            const avatarEl = document.getElementById('sidebarUserAvatar');
            if (nameEl) nameEl.textContent = fullName;
            if (idEl) idEl.textContent = email;
            if (avatarEl && fullName) avatarEl.textContent = fullName.trim().charAt(0).toUpperCase();
        }
    });
</script>
